/* -------------------------- interactive selection ------------------------ */

typedef struct { unsigned long pixel; int width; int line_style; uint8_t r,g,b,opacity; } SelectStyle;

static bool parse_hex_color(const char *s, uint8_t *r, uint8_t *g, uint8_t *b) {
    if (!s) return false;
    if (*s == '#') ++s;
    if (strlen(s) != 6) return false;
    for (int i = 0; i < 6; ++i) if (!isxdigit((unsigned char)s[i])) return false;
    char q[3] = {0};
    q[0] = s[0]; q[1] = s[1]; *r = (uint8_t)strtoul(q, NULL, 16);
    q[0] = s[2]; q[1] = s[3]; *g = (uint8_t)strtoul(q, NULL, 16);
    q[0] = s[4]; q[1] = s[5]; *b = (uint8_t)strtoul(q, NULL, 16);
    return true;
}

static void parse_line_style(XCtx *x, const char *spec, SelectStyle *s) {
    Display *d = x->dpy; Colormap cm = DefaultColormap(d, x->screen);
    s->width = 2; s->line_style = LineSolid;
    s->r = s->g = s->b = 255; s->opacity = 128;
    s->pixel = WhitePixel(d, x->screen);           /* always initialized (M04) */
    XColor c = {0};
    if (XAllocNamedColor(d, cm, "white", &c, &c)) s->pixel = c.pixel;
    char *copy = xstrdup(spec ? spec : ""), *save = NULL;
    for (char *p = strtok_r(copy, ",", &save); p; p = strtok_r(NULL, ",", &save)) {
        while (isspace((unsigned char)*p)) ++p;
        char *eq = strchr(p, '=');
        if (!eq) { if (*p) die("invalid --line token '%s'", p); continue; }
        *eq++ = 0;
        for (char *z = eq - 2; z >= p && isspace((unsigned char)*z); --z) *z = 0; /* trim key */
        if (!strcmp(p, "width")) {
            int v; if (!parse_int_strict(eq, 1, 8, &v)) die("--line width must be 1..8");
            s->width = v;
        } else if (!strcmp(p, "style")) {
            if (!strcasecmp(eq, "dash")) s->line_style = LineOnOffDash;
            else if (!strcasecmp(eq, "solid")) s->line_style = LineSolid;
            else die("--line style must be 'solid' or 'dash'");
        } else if (!strcmp(p, "opacity")) {
            int v; if (!parse_int_strict(eq, 0, 255, &v)) die("--line opacity must be 0..255");
            s->opacity = (uint8_t)v;
        } else if (!strcmp(p, "color")) {
            if (*eq == '"') { eq++; char *z = strrchr(eq, '"'); if (z) *z = 0; }
            if (parse_hex_color(eq, &s->r, &s->g, &s->b)) {
                XColor xc = { .red=(unsigned short)(s->r*257), .green=(unsigned short)(s->g*257),
                              .blue=(unsigned short)(s->b*257), .flags=DoRed|DoGreen|DoBlue };
                if (XAllocColor(d, cm, &xc)) s->pixel = xc.pixel;
            } else if (XAllocNamedColor(d, cm, eq, &c, &c)) {
                s->pixel = c.pixel; s->r=(uint8_t)(c.red/257); s->g=(uint8_t)(c.green/257); s->b=(uint8_t)(c.blue/257);
            } else die("--line color '%s' is not #RRGGBB or a known color name", eq);
        } else {
            die("unknown --line key '%s'", p);
        }
    }
    free(copy);
}

/* Frozen mode: erase the previous border from the snapshot-backed overlay and
   draw the current one. Only the thin border strips are touched, so it never
   flickers and never repaints the whole screen. */
static void sel_freeze_draw(Display *d, Window ov, GC gc, Rect prev, Rect cur, int lw) {
    int h = lw + 2;                                  /* erase band thickness */
    if (rect_valid(prev)) {                          /* restore snapshot under old border */
        XClearArea(d, ov, prev.x - h, prev.y - h, (unsigned)(prev.w + 2 * h), (unsigned)(2 * h), False);
        XClearArea(d, ov, prev.x - h, prev.y + prev.h - h, (unsigned)(prev.w + 2 * h), (unsigned)(2 * h), False);
        XClearArea(d, ov, prev.x - h, prev.y - h, (unsigned)(2 * h), (unsigned)(prev.h + 2 * h), False);
        XClearArea(d, ov, prev.x + prev.w - h, prev.y - h, (unsigned)(2 * h), (unsigned)(prev.h + 2 * h), False);
    }
    if (rect_valid(cur))
        XDrawRectangle(d, ov, gc, cur.x, cur.y, (unsigned)MAX2(0, cur.w - 1), (unsigned)MAX2(0, cur.h - 1));
}

/* Live mode: shape the transparent overlay so only the rubber-band border is a
   real window; the live desktop shows through everywhere else. The border can
   therefore never appear in the captured root image. */
static void sel_live_shape(const XExt *e, Display *d, Window ov, Rect r, int lw) {
    if (!rect_valid(r)) {                             /* nothing selected yet: hide overlay */
        e->XShapeCombineRectangles(d, ov, I3_SHAPE_BOUNDING, 0, 0, NULL, 0, I3_SHAPE_SET, I3_SHAPE_UNSORTED);
        XClearWindow(d, ov);
        return;
    }
    int w = MAX2(1, MIN2(lw, r.w)), h = MAX2(1, MIN2(lw, r.h));
    XRectangle bars[4] = {
        { (short)r.x,             (short)r.y,               (unsigned short)r.w, (unsigned short)h },
        { (short)r.x,             (short)(r.y + r.h - h),   (unsigned short)r.w, (unsigned short)h },
        { (short)r.x,             (short)r.y,               (unsigned short)w,   (unsigned short)r.h },
        { (short)(r.x + r.w - w), (short)r.y,               (unsigned short)w,   (unsigned short)r.h },
    };
    e->XShapeCombineRectangles(d, ov, I3_SHAPE_BOUNDING, 0, 0, bars, 4, I3_SHAPE_SET, I3_SHAPE_UNSORTED);
    XClearWindow(d, ov);                             /* paint visible border with bg colour */
}

/* Interactive rectangle/window selection.
 *
 * The rubber band is always drawn on a dedicated override-redirect overlay,
 * never on the root window, so it cannot leak into the screenshot. Two render
 * modes are used:
 *   - live  (default): SHAPE-clipped transparent overlay over the live desktop.
 *   - freeze (-f, or when SHAPE is missing): opaque overlay showing a snapshot;
 *     the caller crops the final image from that clean snapshot.
 * On success with a snapshot, *frozen_image receives it; the caller owns it.
 */
static bool interactive_select(XCtx *x, bool freeze, bool ignore_keyboard,
                               const SelectStyle *st, Rect *out, Window *clicked,
                               XImage **frozen_image) {
    Display *d = x->dpy;
    *clicked = None;
    if (frozen_image) *frozen_image = NULL;

    /* Pick render mode. SHAPE is required for a transparent live overlay. */
    int seb = 0, ser = 0;
    bool shape_ok = x->ext.XShapeQueryExtension && x->ext.XShapeCombineRectangles &&
                    x->ext.XShapeQueryExtension(d, &seb, &ser);
    bool use_freeze = freeze || !shape_ok;

    XImage *snap = NULL;
    if (use_freeze) {                                /* need a clean snapshot to draw over */
        snap = XGetImage(d, x->root, 0, 0, (unsigned)x->root_w, (unsigned)x->root_h, AllPlanes, ZPixmap);
        if (!snap) {                                 /* fall back to live if snapshot fails */
            if (shape_ok) use_freeze = false;
            else { warnx("cannot snapshot the screen for selection"); return false; }
        }
    }

    /* Create the override-redirect overlay covering the whole root. */
    XSetWindowAttributes a; memset(&a, 0, sizeof(a));
    a.override_redirect = True;
    a.background_pixel = st->pixel;                  /* live border colour */
    a.border_pixel = 0;
    a.event_mask = ExposureMask;
    Window ov = XCreateWindow(d, x->root, 0, 0, (unsigned)x->root_w, (unsigned)x->root_h, 0,
                              CopyFromParent, InputOutput, CopyFromParent,
                              CWOverrideRedirect | CWBackPixel | CWBorderPixel | CWEventMask, &a);
    if (ov == None) { if (snap) XDestroyImage(snap); warnx("cannot create selection overlay"); return false; }

    Pixmap bg = None;
    if (use_freeze) {                                /* back overlay with the snapshot */
        bg = XCreatePixmap(d, x->root, (unsigned)x->root_w, (unsigned)x->root_h,
                           (unsigned)DefaultDepth(d, x->screen));
        GC pg = XCreateGC(d, bg, 0, NULL);
        XPutImage(d, bg, pg, snap, 0, 0, 0, 0, (unsigned)x->root_w, (unsigned)x->root_h);
        XFreeGC(d, pg);
        XSetWindowBackgroundPixmap(d, ov, bg);
    } else {                                         /* start hidden until first drag */
        x->ext.XShapeCombineRectangles(d, ov, I3_SHAPE_BOUNDING, 0, 0, NULL, 0, I3_SHAPE_SET, I3_SHAPE_UNSORTED);
    }

    /* Identify the overlay and ask compositors not to fade/shadow it, so their
       effects can never bleed into the capture (Picom-safe). Users can also
       target it with rules via WM_CLASS "i3shot". */
    {
        XClassHint ch; ch.res_name = (char*)"i3shot"; ch.res_class = (char*)"i3shot";
        XSetClassHint(d, ov, &ch);
        XStoreName(d, ov, "i3shot selection");
        Atom util = atom(d, "_NET_WM_WINDOW_TYPE_UTILITY");
        XChangeProperty(d, ov, atom(d, "_NET_WM_WINDOW_TYPE"), XA_ATOM, 32,
                        PropModeReplace, (unsigned char*)&util, 1);
        long bypass = 1;                             /* 1 = disable compositing for this window */
        XChangeProperty(d, ov, atom(d, "_NET_WM_BYPASS_COMPOSITOR"), XA_CARDINAL, 32,
                        PropModeReplace, (unsigned char*)&bypass, 1);
    }
    XMapRaised(d, ov);
    XClearWindow(d, ov);
    XSync(d, False);

    /* Grab input for the whole gesture, retrying briefly since another client
       may hold a transient grab (i3 bindings, menus, launchers). */
    Cursor cur = XCreateFontCursor(d, XC_crosshair);
    unsigned pmask = ButtonPressMask | ButtonReleaseMask | PointerMotionMask;
    int gp = AlreadyGrabbed;
    for (int tries = 0; tries < 100 && !g_interrupted; ++tries) {
        gp = XGrabPointer(d, x->root, False, pmask, GrabModeAsync, GrabModeAsync, x->root, cur, CurrentTime);
        if (gp == GrabSuccess) break;
        sleep_seconds(0.02);
    }
    if (gp != GrabSuccess) {
        XFreeCursor(d, cur);
        if (bg) XFreePixmap(d, bg);
        XDestroyWindow(d, ov);
        if (snap) XDestroyImage(snap);
        warnx("cannot grab the pointer for selection");
        return false;
    }
    bool kb_grabbed = false;
    for (int tries = 0; tries < 50 && !g_interrupted; ++tries) {
        if (XGrabKeyboard(d, x->root, False, GrabModeAsync, GrabModeAsync, CurrentTime) == GrabSuccess) { kb_grabbed = true; break; }
        sleep_seconds(0.02);
    }
    if (!kb_grabbed)                                 /* mouse-only: right-click still cancels */
        warnx("keyboard grab unavailable; use right-click to cancel");

    /* Colour GC used only by the frozen-mode border. */
    GC gc = None;
    if (use_freeze) {
        XGCValues gv; memset(&gv, 0, sizeof(gv));
        gv.foreground = st->pixel;
        gc = XCreateGC(d, ov, GCForeground, &gv);
        XSetLineAttributes(d, gc, (unsigned)st->width, st->line_style, CapButt, JoinMiter);
        if (st->line_style == LineOnOffDash) { char dash[2] = {6, 4}; XSetDashes(d, gc, 0, dash, 2); }
    }

    bool dragging = false, have = false, cancel = false;
    int x1 = 0, y1 = 0, x2 = 0, y2 = 0;
    Rect shown = {0};                                /* currently displayed rect */
    int xfd = ConnectionNumber(d);

    while (!g_interrupted && !cancel && !have) {
        /* Drain queued events, then block in poll() so SIGINT/SIGTERM can wake
           us even when idle (no more frozen selection on kill). */
        while (!g_interrupted && !cancel && !have && XPending(d) > 0) {
            XEvent e; XNextEvent(d, &e);
            switch (e.type) {
            case ButtonPress:
                if (e.xbutton.button == Button1) {
                    dragging = true;
                    x1 = x2 = e.xbutton.x_root; y1 = y2 = e.xbutton.y_root;
                } else if (e.xbutton.button == Button3) {
                    cancel = true;                   /* right-click cancels */
                }
                break;
            case MotionNotify:
                if (dragging) {
                    while (XCheckTypedEvent(d, MotionNotify, &e)) {}   /* coalesce motion */
                    x2 = e.xmotion.x_root; y2 = e.xmotion.y_root;
                    Rect nr = rect_normalize(x1, y1, x2, y2);
                    if (use_freeze) sel_freeze_draw(d, ov, gc, shown, nr, st->width);
                    else            sel_live_shape(&x->ext, d, ov, nr, st->width);
                    shown = nr; XFlush(d);
                }
                break;
            case ButtonRelease:
                if (dragging && e.xbutton.button == Button1) {
                    x2 = e.xbutton.x_root; y2 = e.xbutton.y_root;
                    Rect r = rect_normalize(x1, y1, x2, y2);
                    if (r.w <= 3 && r.h <= 3) {       /* tiny drag: treat as a window click */
                        *clicked = window_at_point(x, x2, y2);
                        if (!window_absolute_rect(x, *clicked, false, &r)) {
                            warnx("cannot determine geometry of the clicked window");
                            cancel = true; break;    /* never save a stale 1x1 rectangle */
                        }
                    }
                    *out = r; have = true;
                }
                break;
            case KeyPress: {
                KeySym ks = XLookupKeysym(&e.xkey, 0);
                if (ks == XK_Escape) { cancel = true; break; }
                if (ignore_keyboard) break;
                if ((ks == XK_Return || ks == XK_KP_Enter) && dragging) {
                    *out = rect_normalize(x1, y1, x2, y2); have = true;
                } else if (dragging && (ks == XK_Left || ks == XK_Right || ks == XK_Up || ks == XK_Down)) {
                    int step = (e.xkey.state & ShiftMask) ? 10 : 1;
                    if (ks == XK_Left)  x2 -= step;
                    if (ks == XK_Right) x2 += step;
                    if (ks == XK_Up)    y2 -= step;
                    if (ks == XK_Down)  y2 += step;
                    x2 = CLAMP(x2, 0, x->root_w);    /* keep endpoint on-screen */
                    y2 = CLAMP(y2, 0, x->root_h);
                    Rect nr = rect_normalize(x1, y1, x2, y2);
                    if (use_freeze) sel_freeze_draw(d, ov, gc, shown, nr, st->width);
                    else            sel_live_shape(&x->ext, d, ov, nr, st->width);
                    shown = nr; XFlush(d);
                }
                break;
            }
            case Expose:
                if (use_freeze && rect_valid(shown)) /* keep border after a repaint */
                    XDrawRectangle(d, ov, gc, shown.x, shown.y,
                                   (unsigned)MAX2(0, shown.w - 1), (unsigned)MAX2(0, shown.h - 1));
                break;
            default: break;
            }
        }
        if (g_interrupted || cancel || have) break;
        struct pollfd pfd[2] = { { xfd, POLLIN, 0 }, { g_sigpipe[0], POLLIN, 0 } };
        int np = (g_sigpipe[0] >= 0) ? 2 : 1;
        if (poll(pfd, (nfds_t)np, -1) < 0) { if (errno == EINTR) continue; break; }
        if (np == 2 && (pfd[1].revents & POLLIN)) { char b[64]; while (read(g_sigpipe[0], b, sizeof b) > 0) {} break; }
    }

    /* Tear the overlay down and make the screen pristine before any capture. */
    XUngrabKeyboard(d, CurrentTime);
    XUngrabPointer(d, CurrentTime);
    if (gc) XFreeGC(d, gc);
    XFreeCursor(d, cur);
    XUnmapWindow(d, ov);
    XDestroyWindow(d, ov);
    if (bg) XFreePixmap(d, bg);
    XSync(d, True);                                  /* apply destroy, drop stale events */

    bool ok = have && !cancel && !g_interrupted;
    if (ok && use_freeze && frozen_image) {
        *frozen_image = snap;                        /* caller crops from clean snapshot */
    } else {
        if (snap) XDestroyImage(snap);
        if (ok && !use_freeze) {                     /* let the compositor fully repaint freed strips */
            XSync(d, False);
            sleep_seconds(0.12);
            XSync(d, False);
        }
    }
    return ok;
}

