static Atom atom(Display *d, const char *name) { return XInternAtom(d,name,False); }

static void xerror_begin(Display *d) {
    XSync(d, False);                                /* flush unrelated old errors first */
    g_xerror = 0;
}

static int xerror_end(Display *d) {
    XSync(d, False);
    return g_xerror;
}

static bool refresh_root_geometry(XCtx *x) {
    XWindowAttributes a;
    if (!XGetWindowAttributes(x->dpy, x->root, &a) || a.width <= 0 || a.height <= 0)
        return false;
    x->root_w = a.width;
    x->root_h = a.height;
    return true;
}

static bool compositor_active(XCtx *x) {
    char name[64];
    snprintf(name, sizeof(name), "_NET_WM_CM_S%d", x->screen);
    return XGetSelectionOwner(x->dpy, atom(x->dpy, name)) != None;
}

static void xext_probe(XCtx *x) {
    int eb = 0, er = 0, major = 5, minor = 0;
    x->fixes_ok = x->ext.XFixesGetCursorImage && x->ext.XFixesQueryExtension &&
                  x->ext.XFixesQueryVersion && x->ext.XFixesQueryExtension(x->dpy, &eb, &er) &&
                  x->ext.XFixesQueryVersion(x->dpy, &major, &minor);
    major = 1; minor = 5;
    x->randr_ok = x->ext.XRRGetMonitors && x->ext.XRRFreeMonitors &&
                  x->ext.XRRQueryExtension && x->ext.XRRQueryVersion &&
                  x->ext.XRRQueryExtension(x->dpy, &eb, &er) &&
                  x->ext.XRRQueryVersion(x->dpy, &major, &minor) &&
                  (major > 1 || (major == 1 && minor >= 5));
    major = 0; minor = 4;
    x->composite_ok = x->ext.XCompositeNameWindowPixmap &&
                      x->ext.XCompositeQueryExtension && x->ext.XCompositeQueryVersion &&
                      x->ext.XCompositeQueryExtension(x->dpy, &eb, &er) &&
                      x->ext.XCompositeQueryVersion(x->dpy, &major, &minor);
    x->shape_ok = x->ext.XShapeQueryExtension && x->ext.XShapeCombineRectangles &&
                  x->ext.XShapeQueryExtension(x->dpy, &eb, &er);
}

static bool get_property_limited(Display *d, Window w, Atom prop, Atom req_type,
                                 unsigned long max_items, unsigned char **data,
                                 unsigned long *nitems, Atom *actual_type, int *actual_format) {
    unsigned long after = 0;
    *data = NULL; *nitems = 0;
    int st = XGetWindowProperty(d, w, prop, 0, (long)max_items, False, req_type,
                                actual_type, actual_format, nitems, &after, data);
    if (st != Success || !*data) return false;
    if (after != 0) { XFree(*data); *data = NULL; *nitems = 0; return false; }
    return true;
}

static char *get_text_property_utf8(Display *d, Window w, const char *propname) {
    Atom actual; int fmt; unsigned long n=0; unsigned char *data=NULL;
    Atom utf8=atom(d,"UTF8_STRING");
    if(get_property_limited(d,w,atom(d,propname),utf8,262144,&data,&n,&actual,&fmt) && fmt==8) {
        char *s=xmalloc(n+1); memcpy(s,data,n); s[n]='\0'; XFree(data); return s;
    }
    if(data) XFree(data);
    XTextProperty tp;
    if (XGetWMName(d, w, &tp) && tp.value) {
        char **list = NULL; int count = 0;
        if (Xutf8TextPropertyToTextList(d, &tp, &list, &count) >= Success && list && count > 0) {
            char *s = xstrdup(list[0]); XFreeStringList(list); XFree(tp.value); return s;
        }
        if (list) XFreeStringList(list);
        char *s = xmalloc((size_t)tp.nitems + 1);
        memcpy(s, tp.value, tp.nitems); s[tp.nitems] = '\0'; XFree(tp.value); return s;
    }
    return xstrdup("");
}

static bool window_is_capture_candidate(XCtx *x, Window w) {
    if (w == None || w == PointerRoot || w == x->root) return false;
    XWindowAttributes a;
    return XGetWindowAttributes(x->dpy, w, &a) && a.class == InputOutput &&
           a.map_state != IsUnmapped && a.width > 0 && a.height > 0;
}

static Window get_active_window(XCtx *x) {
    unsigned char *data=NULL; unsigned long n=0; Atom actual; int fmt;
    Window w=None;
    if(get_property_limited(x->dpy,x->root,atom(x->dpy,"_NET_ACTIVE_WINDOW"),XA_WINDOW,1,&data,&n,&actual,&fmt) && n>=1 && fmt==32)
        w=*(Window*)data;
    if(data) XFree(data);
    if(window_is_capture_candidate(x, w)) return w;
    Window focus=None; int revert=0;
    XGetInputFocus(x->dpy,&focus,&revert);
    return window_is_capture_candidate(x, focus) ? focus : None;
}

static bool window_absolute_rect(XCtx *x, Window w, bool border, Rect *out) {
    XWindowAttributes a;
    if(!XGetWindowAttributes(x->dpy,w,&a) || a.map_state==IsUnmapped) return false;
    Window child=None; int rx=0,ry=0;
    if(!XTranslateCoordinates(x->dpy,w,x->root,0,0,&rx,&ry,&child)) return false;
    Rect r={rx,ry,a.width,a.height};
    if(border) {
        unsigned char *data=NULL; unsigned long n=0; Atom actual; int fmt;
        if(get_property_limited(x->dpy,w,atom(x->dpy,"_NET_FRAME_EXTENTS"),XA_CARDINAL,4,&data,&n,&actual,&fmt) && n>=4 && fmt==32) {
            unsigned long *v=(unsigned long*)data;
            long l=(long)v[0],rr=(long)v[1],t=(long)v[2],b=(long)v[3];
            const long CAP=100000;                 /* reject absurd extents */
            if(l>=0&&l<=CAP&&rr>=0&&rr<=CAP&&t>=0&&t<=CAP&&b>=0&&b<=CAP){
                int64_t nx=(int64_t)r.x-l, ny=(int64_t)r.y-t;
                int64_t nw=(int64_t)r.w+l+rr, nh=(int64_t)r.h+t+b;
                r=(Rect){clamp_i64_to_int(nx),clamp_i64_to_int(ny),clamp_i64_to_int(nw),clamp_i64_to_int(nh)};
            }
            XFree(data);
        } else if(data) XFree(data);
    }
    r=rect_intersect(r,(Rect){0,0,x->root_w,x->root_h});
    if (!rect_valid(r)) return false;
    *out = r;
    return true;
}

static uint8_t component_from_mask(unsigned long pixel, unsigned long mask) {
    if(!mask) return 0;
    int shift=0; while(((mask>>shift)&1ul)==0ul && shift<(int)(sizeof(mask)*8-1)) ++shift;
    unsigned long max=mask>>shift, v=(pixel&mask)>>shift;
    return (uint8_t)((v*255ul + max/2ul)/max);
}

static unsigned long ximage_pixel_fast(const XImage *xi, int x, int y) {
    const uint8_t *p = (const uint8_t *)xi->data + (size_t)y * xi->bytes_per_line;
    int bpp = xi->bits_per_pixel;
    if (bpp == 32) {
        p += (size_t)x * 4;
        if (xi->byte_order == LSBFirst)
            return (unsigned long)p[0] | ((unsigned long)p[1] << 8) |
                   ((unsigned long)p[2] << 16) | ((unsigned long)p[3] << 24);
        return ((unsigned long)p[0] << 24) | ((unsigned long)p[1] << 16) |
               ((unsigned long)p[2] << 8) | (unsigned long)p[3];
    }
    if (bpp == 24) {
        p += (size_t)x * 3;
        if (xi->byte_order == LSBFirst)
            return (unsigned long)p[0] | ((unsigned long)p[1] << 8) | ((unsigned long)p[2] << 16);
        return ((unsigned long)p[0] << 16) | ((unsigned long)p[1] << 8) | (unsigned long)p[2];
    }
    if (bpp == 16) {
        p += (size_t)x * 2;
        if (xi->byte_order == LSBFirst) return (unsigned long)p[0] | ((unsigned long)p[1] << 8);
        return ((unsigned long)p[0] << 8) | (unsigned long)p[1];
    }
    return XGetPixel((XImage *)xi, x, y);
}

static Image ximage_to_rgb(XCtx *x, XImage *xi, Rect crop) {
    crop = rect_intersect(crop, (Rect){0, 0, xi->width, xi->height});
    Image im = image_new(crop.w, crop.h);
    bool indexed = xi->red_mask == 0 && xi->green_mask == 0 && xi->blue_mask == 0;
    XColor palette[256];
    int palette_n = 0;
    if (indexed && xi->depth <= 8) {
        palette_n = 1 << xi->depth;
        if (palette_n > 256) palette_n = 256;
        for (int i = 0; i < palette_n; ++i) { palette[i].pixel = (unsigned long)i; palette[i].flags = DoRed|DoGreen|DoBlue; }
        XQueryColors(x->dpy, DefaultColormap(x->dpy, x->screen), palette, palette_n);
    }
    for (int y = 0; y < crop.h; ++y) {
        for (int xx = 0; xx < crop.w; ++xx) {
            unsigned long p = ximage_pixel_fast(xi, crop.x + xx, crop.y + y);
            uint8_t *q = im.rgb + ((size_t)y * crop.w + xx) * 3;
            if (palette_n > 0 && p < (unsigned long)palette_n) {
                q[0] = (uint8_t)(palette[p].red / 257u);
                q[1] = (uint8_t)(palette[p].green / 257u);
                q[2] = (uint8_t)(palette[p].blue / 257u);
            } else {
                q[0] = component_from_mask(p, xi->red_mask);
                q[1] = component_from_mask(p, xi->green_mask);
                q[2] = component_from_mask(p, xi->blue_mask);
            }
        }
    }
    return im;
}

static Image capture_root(XCtx *x, Rect r) {
    r=rect_intersect(r,(Rect){0,0,x->root_w,x->root_h});
    if(!rect_valid(r)) die("capture rectangle is outside the X11 root window");
    xerror_begin(x->dpy);
    XImage *xi=XGetImage(x->dpy,x->root,r.x,r.y,(unsigned)r.w,(unsigned)r.h,AllPlanes,ZPixmap);
    int xe = xerror_end(x->dpy);
    if(!xi || xe) { if (xi) XDestroyImage(xi); die("XGetImage failed for %dx%d+%d+%d",r.w,r.h,r.x,r.y); }
    Image im=ximage_to_rgb(x,xi,(Rect){0,0,r.w,r.h}); XDestroyImage(xi); return im;
}

static Image capture_window_content(XCtx *x, Window w, bool try_composite) {
    XWindowAttributes a;
    if(!XGetWindowAttributes(x->dpy,w,&a) || a.width<=0 || a.height<=0) die("cannot query window 0x%lx",w);
    Drawable dr=w; Pixmap pm=None;
    if(try_composite && x->composite_ok) {
        xerror_begin(x->dpy); pm=x->ext.XCompositeNameWindowPixmap(x->dpy,w);
        if(!xerror_end(x->dpy) && pm!=None) dr=pm; else pm=None;
    }
    xerror_begin(x->dpy);
    XImage *xi=XGetImage(x->dpy,dr,0,0,(unsigned)a.width,(unsigned)a.height,AllPlanes,ZPixmap);
    int xe = xerror_end(x->dpy);
    if(pm!=None) XFreePixmap(x->dpy,pm);
    if(!xi || xe) {
        if(xi) XDestroyImage(xi);                   /* don't leak a valid image on async error */
        Rect r; if(!window_absolute_rect(x,w,false,&r)) die("cannot capture window 0x%lx",w);
        return capture_root(x,r);
    }
    Image im=ximage_to_rgb(x,xi,(Rect){0,0,a.width,a.height}); XDestroyImage(xi); return im;
}

static void compose_cursor(XCtx *x, Image *im, Rect capture_rect) {
    if(!x->fixes_ok) { warnx("XFixes is unavailable; cursor was not captured"); return; }
    DynXFixesCursorImage *ci=x->ext.XFixesGetCursorImage(x->dpy);
    if(!ci) { warnx("XFixesGetCursorImage failed"); return; }
    int ox=(int)ci->x-(int)ci->xhot-capture_rect.x, oy=(int)ci->y-(int)ci->yhot-capture_rect.y;
    for(int y=0;y<(int)ci->height;++y) for(int xx=0;xx<(int)ci->width;++xx) {
        int dx=ox+xx,dy=oy+y; if(dx<0||dy<0||dx>=im->w||dy>=im->h) continue;
        unsigned long p=ci->pixels[(size_t)y*ci->width+xx];
        uint8_t a=(uint8_t)(p>>24), r=(uint8_t)(p>>16), g=(uint8_t)(p>>8), b=(uint8_t)p;
        uint8_t *q=im->rgb+((size_t)dy*im->w+dx)*3;
        /* XFixes pixels are premultiplied ARGB. */
        q[0]=(uint8_t)CLAMP((int)r + ((int)q[0]*(255-a)+127)/255,0,255);
        q[1]=(uint8_t)CLAMP((int)g + ((int)q[1]*(255-a)+127)/255,0,255);
        q[2]=(uint8_t)CLAMP((int)b + ((int)q[2]*(255-a)+127)/255,0,255);
    }
    XFree(ci);
}

static Rect *get_monitors(XCtx *x, int *count) {
    *count = 0;
    if (!x->randr_ok) return NULL;
    xerror_begin(x->dpy);
    int n = 0;
    DynXRRMonitorInfo *mi = x->ext.XRRGetMonitors(x->dpy, x->root, True, &n);
    int xe = xerror_end(x->dpy);
    if (!mi || xe || n <= 0) { if (mi) x->ext.XRRFreeMonitors(mi); return NULL; }
    Rect *r = xcalloc((size_t)n, sizeof(*r));
    for (int i = 0; i < n; ++i) {
        if (mi[i].width <= 0 || mi[i].height <= 0) { free(r); x->ext.XRRFreeMonitors(mi); return NULL; }
        r[i] = (Rect){mi[i].x, mi[i].y, mi[i].width, mi[i].height};
    }
    x->ext.XRRFreeMonitors(mi);
    *count = n;
    return r;
}

static Window window_at_point(XCtx *x, int px, int py) {
    unsigned char *data=NULL; unsigned long n=0; Atom actual; int fmt;
    if(get_property_limited(x->dpy,x->root,atom(x->dpy,"_NET_CLIENT_LIST_STACKING"),XA_WINDOW,1048576,&data,&n,&actual,&fmt) && fmt==32) {
        Window *ws=(Window*)data;
        for(long i=(long)n-1;i>=0;--i) { Rect r; if(window_absolute_rect(x,ws[i],true,&r) && px>=r.x&&py>=r.y&&px<r.x+r.w&&py<r.y+r.h) { Window w=ws[i]; XFree(data); return w; } }
        XFree(data);
    } else if(data) XFree(data);
    Window rr,child=None; int rx,ry,wx,wy; unsigned mask;
    if(XQueryPointer(x->dpy,x->root,&rr,&child,&rx,&ry,&wx,&wy,&mask) && child!=None) return child;
    return x->root;
}

static bool window_class_matches(Display *d, Window w, const char *want) {
    if(!want||!*want) return true;
    XClassHint h={0}; bool ok=false;
    if(XGetClassHint(d,w,&h)) {
        ok=(h.res_name&&strcasecmp(h.res_name,want)==0)||(h.res_class&&strcasecmp(h.res_class,want)==0);
        if (h.res_name) XFree(h.res_name);
        if (h.res_class) XFree(h.res_class);
    }
    return ok;
}

static Image capture_stack_under_pointer(XCtx *x, bool vertical, const char *class_name, bool composite, Rect *logical_rect) {
    Window rr,child; int px,py,wx,wy; unsigned mask;
    if(!XQueryPointer(x->dpy,x->root,&rr,&child,&px,&py,&wx,&wy,&mask))die("cannot query pointer");
    unsigned char *data=NULL;unsigned long n=0;Atom actual;int fmt;
    if(!get_property_limited(x->dpy,x->root,atom(x->dpy,"_NET_CLIENT_LIST_STACKING"),XA_WINDOW,1048576,&data,&n,&actual,&fmt)||fmt!=32)
        die("_NET_CLIENT_LIST_STACKING is unavailable");
    Window *ws=(Window*)data,*sel=xcalloc(n?n:1,sizeof(Window));int ns=0;
    for(unsigned long i=0;i<n;++i){Rect r;if(window_absolute_rect(x,ws[i],false,&r)&&px>=r.x&&py>=r.y&&px<r.x+r.w&&py<r.y+r.h&&window_class_matches(x->dpy,ws[i],class_name))sel[ns++]=ws[i];}
    XFree(data);if(ns==0){free(sel);die("no matching windows are stacked under the pointer");}

    Rect *dims=xcalloc((size_t)ns,sizeof(*dims));int64_t ow=0,oh=0;uint64_t largest=0;
    for(int i=0;i<ns;++i){XWindowAttributes a;if(!XGetWindowAttributes(x->dpy,sel[i],&a)||a.width<=0||a.height<=0){free(dims);free(sel);die("a stacked window disappeared before capture");}
        dims[i]=(Rect){0,0,a.width,a.height};uint64_t bytes=(uint64_t)(unsigned)a.width*(uint64_t)(unsigned)a.height*3u;if(bytes>largest)largest=bytes;
        if(vertical){if(a.width>ow)ow=a.width;oh+=a.height;}else{ow+=a.width;if(a.height>oh)oh=a.height;}}
    if(ow<=0||oh<=0||ow>INT_MAX||oh>INT_MAX){free(dims);free(sel);die("joined stack area is too large");}
    uint64_t outbytes=(uint64_t)ow*(uint64_t)oh*3u;ensure_work_budget(outbytes+largest,"stack capture");
    Image out=image_new((int)ow,(int)oh);int ox=0,oy=0;
    for(int i=0;i<ns;++i){Image part=capture_window_content(x,sel[i],composite);if(part.w!=dims[i].w||part.h!=dims[i].h){image_free(&part);image_free(&out);free(dims);free(sel);die("a stacked window resized during capture; retry");}
        for(int y=0;y<part.h;++y)memcpy(out.rgb+((size_t)(oy+y)*(size_t)ow+(size_t)ox)*3,part.rgb+(size_t)y*(size_t)part.w*3,(size_t)part.w*3);
        if(vertical)oy+=part.h;else ox+=part.w;image_free(&part);}
    free(dims);free(sel);*logical_rect=(Rect){0,0,(int)ow,(int)oh};return out;
}

/* ------------------------------- i3 IPC ----------------------------------- */

typedef enum { JT_UNDEF, JT_OBJECT, JT_ARRAY, JT_STRING, JT_PRIMITIVE } JType;
typedef struct { JType type; int start,end,size,parent; } JTok;

typedef struct {
    const char *js;
    size_t len, pos, n, cap;
    unsigned depth;
    JTok *t;
} JReader;

static void json_skip_ws(JReader *p) {
    while (p->pos < p->len && isspace((unsigned char)p->js[p->pos])) ++p->pos;
}

static int json_new_token(JReader *p, JType type, int parent, size_t start) {
    if (p->n >= I3SHOT_MAX_JSON_TOKENS || start > INT_MAX) return -1;
    if (p->n == p->cap) {
        size_t nc = p->cap ? p->cap * 2 : 512;
        if (nc > I3SHOT_MAX_JSON_TOKENS) nc = I3SHOT_MAX_JSON_TOKENS;
        if (nc <= p->cap || nc > SIZE_MAX / sizeof(*p->t)) return -1;
        p->t = xrealloc(p->t, nc * sizeof(*p->t));
        p->cap = nc;
    }
    int idx = (int)p->n++;
    p->t[idx] = (JTok){type, (int)start, -1, 0, parent};
    if (parent >= 0) p->t[parent].size++;
    return idx;
}

static bool json_hex4_at(const char *s, size_t n, size_t pos, unsigned *out) {
    if (pos + 4 > n) return false;
    unsigned v = 0;
    for (size_t i = 0; i < 4; ++i) {
        unsigned char c = (unsigned char)s[pos+i];
        unsigned d;
        if (c >= '0' && c <= '9') d = c - '0';
        else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
        else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
        else return false;
        v = (v << 4) | d;
    }
    *out = v;
    return true;
}

static int json_parse_string(JReader *p, int parent) {
    if (p->pos >= p->len || p->js[p->pos] != '"') return -1;
    size_t start = ++p->pos;
    while (p->pos < p->len) {
        unsigned char c = (unsigned char)p->js[p->pos++];
        if (c == '"') {
            int idx = json_new_token(p, JT_STRING, parent, start);
            if (idx < 0 || p->pos - 1 > INT_MAX) return -1;
            p->t[idx].end = (int)(p->pos - 1);
            return idx;
        }
        if (c < 0x20 || c == 0) return -1;
        if (c != '\\') continue;
        if (p->pos >= p->len) return -1;
        c = (unsigned char)p->js[p->pos++];
        if (strchr("\"\\/bfnrt", (int)c)) continue;
        if (c != 'u') return -1;
        unsigned u = 0;
        if (!json_hex4_at(p->js, p->len, p->pos, &u)) return -1;
        p->pos += 4;
        if (u >= 0xD800 && u <= 0xDBFF) {
            if (p->pos + 6 > p->len || p->js[p->pos] != '\\' || p->js[p->pos+1] != 'u') return -1;
            unsigned lo = 0;
            if (!json_hex4_at(p->js, p->len, p->pos + 2, &lo) || lo < 0xDC00 || lo > 0xDFFF) return -1;
            p->pos += 6;
        } else if (u >= 0xDC00 && u <= 0xDFFF) return -1;
    }
    return -1;
}

static bool json_number_end(const char *s, size_t n, size_t *pos) {
    size_t i = *pos;
    if (i < n && s[i] == '-') ++i;
    if (i >= n) return false;
    if (s[i] == '0') ++i;
    else {
        if (s[i] < '1' || s[i] > '9') return false;
        while (i < n && isdigit((unsigned char)s[i])) ++i;
    }
    if (i < n && s[i] == '.') {
        ++i;
        if (i >= n || !isdigit((unsigned char)s[i])) return false;
        while (i < n && isdigit((unsigned char)s[i])) ++i;
    }
    if (i < n && (s[i] == 'e' || s[i] == 'E')) {
        ++i;
        if (i < n && (s[i] == '+' || s[i] == '-')) ++i;
        if (i >= n || !isdigit((unsigned char)s[i])) return false;
        while (i < n && isdigit((unsigned char)s[i])) ++i;
    }
    *pos = i;
    return true;
}

static int json_parse_value(JReader *p, int parent);

static int json_parse_object(JReader *p, int parent) {
    size_t start = p->pos++;
    int obj = json_new_token(p, JT_OBJECT, parent, start);
    if (obj < 0 || ++p->depth > I3SHOT_MAX_JSON_DEPTH) return -1;
    json_skip_ws(p);
    if (p->pos < p->len && p->js[p->pos] == '}') { p->t[obj].end = (int)++p->pos; --p->depth; return obj; }
    for (;;) {
        if (json_parse_string(p, obj) < 0) return -1;
        json_skip_ws(p);
        if (p->pos >= p->len || p->js[p->pos++] != ':') return -1;
        json_skip_ws(p);
        if (json_parse_value(p, obj) < 0) return -1;
        json_skip_ws(p);
        if (p->pos >= p->len) return -1;
        char c = p->js[p->pos++];
        if (c == '}') { p->t[obj].end = (int)p->pos; --p->depth; return obj; }
        if (c != ',') return -1;
        json_skip_ws(p);
    }
}

static int json_parse_array(JReader *p, int parent) {
    size_t start = p->pos++;
    int arr = json_new_token(p, JT_ARRAY, parent, start);
    if (arr < 0 || ++p->depth > I3SHOT_MAX_JSON_DEPTH) return -1;
    json_skip_ws(p);
    if (p->pos < p->len && p->js[p->pos] == ']') { p->t[arr].end = (int)++p->pos; --p->depth; return arr; }
    for (;;) {
        if (json_parse_value(p, arr) < 0) return -1;
        json_skip_ws(p);
        if (p->pos >= p->len) return -1;
        char c = p->js[p->pos++];
        if (c == ']') { p->t[arr].end = (int)p->pos; --p->depth; return arr; }
        if (c != ',') return -1;
        json_skip_ws(p);
    }
}

static int json_parse_value(JReader *p, int parent) {
    json_skip_ws(p);
    if (p->pos >= p->len || p->js[p->pos] == '\0') return -1;
    if (p->js[p->pos] == '{') return json_parse_object(p, parent);
    if (p->js[p->pos] == '[') return json_parse_array(p, parent);
    if (p->js[p->pos] == '"') return json_parse_string(p, parent);
    size_t start = p->pos;
    if (p->js[p->pos] == 't' && p->pos + 4 <= p->len && !memcmp(p->js+p->pos,"true",4)) p->pos += 4;
    else if (p->js[p->pos] == 'f' && p->pos + 5 <= p->len && !memcmp(p->js+p->pos,"false",5)) p->pos += 5;
    else if (p->js[p->pos] == 'n' && p->pos + 4 <= p->len && !memcmp(p->js+p->pos,"null",4)) p->pos += 4;
    else if (!json_number_end(p->js, p->len, &p->pos)) return -1;
    int idx = json_new_token(p, JT_PRIMITIVE, parent, start);
    if (idx < 0 || p->pos > INT_MAX) return -1;
    p->t[idx].end = (int)p->pos;
    return idx;
}

static int json_parse(const char *js, size_t len, JTok **out) {
    *out = NULL;
    if (!js || len == 0 || len > INT_MAX || memchr(js, '\0', len)) return -1;
    JReader p = {.js=js,.len=len};
    json_skip_ws(&p);
    if (json_parse_value(&p, -1) < 0) { free(p.t); return -1; }
    json_skip_ws(&p);
    if (p.pos != p.len || p.n == 0 || p.n > INT_MAX) { free(p.t); return -1; }
    *out = p.t;
    return (int)p.n;
}

static bool tok_eq(const char *js,const JTok*t,const char*s){size_t n=strlen(s);return t->type==JT_STRING&&(size_t)(t->end-t->start)==n&&!memcmp(js+t->start,s,n);}
static bool tok_prim_eq(const char *js,const JTok*t,const char*s){size_t n=strlen(s);return t->type==JT_PRIMITIVE&&(size_t)(t->end-t->start)==n&&!memcmp(js+t->start,s,n);}

static bool tok_long_checked(const char *js, const JTok *t, long lo, long hi, long *out) {
    if (!t || t->type != JT_PRIMITIVE) return false;
    int n = t->end - t->start;
    if (n <= 0 || n >= 64) return false;
    char b[64]; memcpy(b, js+t->start, (size_t)n); b[n] = 0;
    char *e = NULL; errno = 0; long v = strtol(b, &e, 10);
    if (errno || e == b || *e || v < lo || v > hi) return false;
    *out = v; return true;
}

static bool tok_window_checked(const char *js, const JTok *t, Window *out) {
    if (!t || t->type != JT_PRIMITIVE) return false;
    int n=t->end-t->start; if(n<=0||n>=64)return false;
    char b[64]; memcpy(b,js+t->start,(size_t)n); b[n]=0;
    if (b[0]=='-' || b[0]=='+') return false;
    char *e=NULL; errno=0; unsigned long v=strtoul(b,&e,10);
    if(errno||e==b||*e||v>0xFFFFFFFFUL)return false;
    *out=(Window)v; return true;
}

static int hex4(const char*p){int v=0;for(int i=0;i<4;++i){char c=p[i];int d;if(c>='0'&&c<='9')d=c-'0';else if(c>='a'&&c<='f')d=c-'a'+10;else if(c>='A'&&c<='F')d=c-'A'+10;else return -1;v=(v<<4)|d;}return v;}
static void utf8_put(char**o,unsigned cp){unsigned char*q=(unsigned char*)*o;if(cp<0x80){*q++=(unsigned char)cp;}else if(cp<0x800){*q++=(unsigned char)(0xC0|(cp>>6));*q++=(unsigned char)(0x80|(cp&0x3F));}else if(cp<0x10000){*q++=(unsigned char)(0xE0|(cp>>12));*q++=(unsigned char)(0x80|((cp>>6)&0x3F));*q++=(unsigned char)(0x80|(cp&0x3F));}else{*q++=(unsigned char)(0xF0|(cp>>18));*q++=(unsigned char)(0x80|((cp>>12)&0x3F));*q++=(unsigned char)(0x80|((cp>>6)&0x3F));*q++=(unsigned char)(0x80|(cp&0x3F));}*o=(char*)q;}
static char *tok_string(const char*js,const JTok*t){if(t->type!=JT_STRING)return xstrdup("");int n=t->end-t->start;char *s=xmalloc((size_t)n*3+4);char*o=s;for(int i=t->start;i<t->end;++i){char c=js[i];if(c=='\\'&&i+1<t->end){c=js[++i];switch(c){case'n':*o++='\n';break;case'r':*o++='\r';break;case't':*o++='\t';break;case'b':*o++='\b';break;case'f':*o++='\f';break;case'/':*o++='/';break;case'\\':*o++='\\';break;case'"':*o++='"';break;case'u':{int u=hex4(js+i+1);i+=4;unsigned cp=(unsigned)u;if(cp>=0xD800&&cp<=0xDBFF){int lo=hex4(js+i+3);cp=0x10000u+((cp-0xD800u)<<10)+((unsigned)lo-0xDC00u);i+=6;}utf8_put(&o,cp);}break;default:break;}}else *o++=c;}*o=0;return s;}

static int tok_next_sibling(const JTok*t,int nt,int idx){int end=t[idx].end;int i=idx+1;while(i<nt&&t[i].start<end)i++;return i;}
static int object_get(const char*js,const JTok*t,int nt,int obj,const char*key){if(obj<0||obj>=nt||t[obj].type!=JT_OBJECT)return -1;for(int i=obj+1;i<nt&&t[i].start<t[obj].end;){if(t[i].parent==obj&&t[i].type==JT_STRING){int v=i+1;if(v<nt&&t[v].parent==obj&&tok_eq(js,&t[i],key))return v;i=(v<nt)?tok_next_sibling(t,nt,v):i+1;}else i++;}return -1;}
static int find_object_field(const char*js,const JTok*t,int nt,int root,const char*key,const char*value,JType vt){for(int i=root;i<nt&&t[i].start<t[root].end;++i){if(t[i].type!=JT_OBJECT)continue;int v=object_get(js,t,nt,i,key);if(v>=0&&t[v].type==vt){bool eq=vt==JT_STRING?tok_eq(js,&t[v],value):tok_prim_eq(js,&t[v],value);if(eq)return i;}}return -1;}

static bool object_rect(const char*js,const JTok*t,int nt,int obj,const char*field,Rect*r){
    int q=object_get(js,t,nt,obj,field);if(q<0||t[q].type!=JT_OBJECT)return false;
    int xi=object_get(js,t,nt,q,"x"), yi=object_get(js,t,nt,q,"y"), wi=object_get(js,t,nt,q,"width"), hi=object_get(js,t,nt,q,"height");
    if(xi<0||yi<0||wi<0||hi<0)return false;
    long x,y,w,h;
    if(!tok_long_checked(js,&t[xi],INT_MIN,INT_MAX,&x)||!tok_long_checked(js,&t[yi],INT_MIN,INT_MAX,&y)||
       !tok_long_checked(js,&t[wi],1,INT_MAX,&w)||!tok_long_checked(js,&t[hi],1,INT_MAX,&h))return false;
    *r=(Rect){(int)x,(int)y,(int)w,(int)h};return true;
}

static char *x11_i3_socket(XCtx*x){unsigned char*data=NULL;unsigned long n=0;Atom actual;int fmt;if(get_property_limited(x->dpy,x->root,atom(x->dpy,"I3_SOCKET_PATH"),AnyPropertyType,4096,&data,&n,&actual,&fmt)&&fmt==8&&n>0){char*s=xmalloc(n+1);memcpy(s,data,n);s[n]=0;XFree(data);return s;}if(data)XFree(data);return NULL;}

typedef enum { I3E_NONE, I3E_NO_SOCKET, I3E_CONNECT, I3E_TIMEOUT, I3E_PROTOCOL, I3E_TYPE, I3E_SIZE, I3E_READ, I3E_JSON, I3E_FIELD } I3Error;
static I3Error g_i3_error = I3E_NONE;
static const char *i3_error_text(void){switch(g_i3_error){case I3E_NO_SOCKET:return"no i3 IPC socket was found";case I3E_CONNECT:return"cannot connect to the i3 IPC socket";case I3E_TIMEOUT:return"i3 IPC request timed out";case I3E_PROTOCOL:return"invalid i3 IPC reply header";case I3E_TYPE:return"i3 IPC reply type did not match the request";case I3E_SIZE:return"i3 IPC reply is too large";case I3E_READ:return"i3 IPC reply was incomplete";case I3E_JSON:return"i3 IPC returned invalid JSON";case I3E_FIELD:return"required data is missing from the i3 IPC reply";default:return"unknown i3 IPC error";}}

typedef struct { char *data; size_t len; } I3Reply;
static void i3_reply_free(I3Reply *r){if(r){free(r->data);r->data=NULL;r->len=0;}}

static int64_t now_ms(void){struct timespec ts;if(clock_gettime(CLOCK_MONOTONIC,&ts)<0)return 0;return(int64_t)ts.tv_sec*1000+ts.tv_nsec/1000000;}

static bool fd_wait(int fd, short events, int64_t deadline) {
    for (;;) {
        int64_t rem = deadline - now_ms();
        if (rem <= 0 || g_interrupted) { g_i3_error = g_interrupted ? I3E_READ : I3E_TIMEOUT; return false; }
        struct pollfd p[2]={{fd,events,0},{g_sigpipe[0],POLLIN,0}};
        nfds_t n=(g_sigpipe[0]>=0)?2:1;
        int timeout=(int)MIN2(rem,INT_MAX);
        int r=poll(p,n,timeout);
