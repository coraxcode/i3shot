    }
}

static bool sock_write_all(int fd,const void*buf,size_t len,int64_t deadline){const uint8_t*p=buf;while(len){if(!fd_wait(fd,POLLOUT,deadline))return false;ssize_t n=write(fd,p,len);if(n<0){if(errno==EINTR||errno==EAGAIN||errno==EWOULDBLOCK)continue;return false;}if(n==0)return false;p+=(size_t)n;len-=(size_t)n;}return true;}
