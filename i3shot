/* fsync the directory holding path so the rename is durable after power loss. */
static void fsync_parent_dir(const char *path) {
    char buf[PATH_MAX];
    if (snprintf(buf, sizeof(buf), "%s", path) >= (int)sizeof(buf)) return;
    char *slash = strrchr(buf, '/');
    const char *dir = slash ? (slash == buf ? "/" : (*slash = 0, buf)) : ".";
    int dfd = open(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
    if (dfd >= 0) { fsync(dfd); close(dfd); }
}

/* Write bytes to a private temp file and atomically place it at path.
   Never overwrites unless requested (uses RENAME_NOREPLACE where available,
   otherwise a hard link, with no unsafe check-then-rename fallback). */
static bool save_bytes_atomic(const char *path, const uint8_t *data, size_t n, bool overwrite, mode_t mode) {
    if (!strcmp(path, "-")) return write_all_fd(STDOUT_FILENO, data, n);

    char tmp[PATH_MAX];
    if (snprintf(tmp, sizeof(tmp), "%s.tmp.XXXXXX", path) >= (int)sizeof(tmp)) { errno = ENAMETOOLONG; return false; }
    int fd = mkstemp(tmp);
    if (fd < 0) return false;

    /* Honor a restrictive umask; default to private 0600 so screenshots are
       not world-readable on shared machines. */
    mode_t um = umask(0); umask(um);
    mode_t final_mode = mode & ~um;
    bool ok = fchmod(fd, final_mode) == 0 && write_all_fd(fd, data, n) && fsync(fd) == 0;
    if (close(fd) < 0) ok = false;

    if (ok) {
        if (overwrite) {
            ok = rename(tmp, path) == 0;
        } else {
#if defined(__linux__) && defined(SYS_renameat2) && defined(RENAME_NOREPLACE)
            long rc = syscall(SYS_renameat2, AT_FDCWD, tmp, AT_FDCWD, path, RENAME_NOREPLACE);
            if (rc == 0) ok = true;
            else if (errno == EEXIST) { int e = errno; unlink(tmp); errno = e; return false; }
            else ok = (link(tmp, path) == 0);      /* fs without renameat2: atomic link */
#else
            ok = (link(tmp, path) == 0);
#endif
            if (ok) { unlink(tmp); fsync_parent_dir(path); return true; }
            if (errno == EEXIST) { int e = errno; unlink(tmp); errno = e; return false; }
        }
    }
    if (ok) { fsync_parent_dir(path); return true; }
    int e = errno; unlink(tmp); errno = e;          /* preserve the real failure (H37) */
    return false;
}

/* Build "stem-N.ext" from path (append "-N" when there is no extension). */
static char *indexed_path(const char *path, int n) {
    const char *slash = strrchr(path, '/');
    const char *dot = strrchr(path, '.');
    size_t stem = (dot && (!slash || dot > slash)) ? (size_t)(dot - path) : strlen(path);
    char *out = xmalloc(strlen(path) + 32);
    sprintf(out, "%.*s-%d%s", (int)stem, path, n, path + stem);
    return out;
}

/* Save without ever overwriting: on collision pick the next free "name-N.ext".
   Each attempt is atomic (no unsafe check-then-rename), so rapid or concurrent
   captures never clobber an existing file. It can still fail on I/O, permission
   or space errors, or after exhausting the numbering; callers report errno.
   On success *path_io is updated to the name actually used. */
static bool save_unique(char **path_io, const uint8_t *data, size_t n, bool overwrite, mode_t mode) {
    if (overwrite || !strcmp(*path_io, "-"))
        return save_bytes_atomic(*path_io, data, n, overwrite, mode);
    if (save_bytes_atomic(*path_io, data, n, false, mode)) return true;
    if (errno != EEXIST) return false;
    for (int i = 1; i < 1000000; ++i) {
        char *cand = indexed_path(*path_io, i);
        if (save_bytes_atomic(cand, data, n, false, mode)) { free(*path_io); *path_io = cand; return true; }
        int e = errno; free(cand);
        if (e != EEXIST) { errno = e; return false; }
    }
    errno = EEXIST;
    return false;
}

static void child_setenv(const char *name, const char *value) {
    if (setenv(name, value ? value : "", 1) < 0) _exit(126);
}

/* Post commands receive ordinary shell environment variables. This makes the
   natural and safe form `"$f"` work correctly and avoids rewriting shell text. */
static int run_post_command(const char *cmd, const ExpandInfo *i) {
    pid_t pid = fork();
    if (pid < 0) return -1;
    if (pid == 0) {
        (void)setpgid(0, 0);
        struct sigaction sa; memset(&sa, 0, sizeof(sa)); sa.sa_handler = SIG_DFL; sigemptyset(&sa.sa_mask);
        sigaction(SIGPIPE, &sa, NULL); sigaction(SIGINT, &sa, NULL); sigaction(SIGTERM, &sa, NULL);
        sigaction(SIGHUP, &sa, NULL); sigaction(SIGQUIT, &sa, NULL); sigaction(SIGCHLD, &sa, NULL);
        sigset_t empty_mask; sigemptyset(&empty_mask); (void)sigprocmask(SIG_SETMASK, &empty_mask, NULL);
        char num[64], host[256];
        const char *base = i->path ? strrchr(i->path, '/') : NULL; base = base ? base + 1 : (i->path ? i->path : "");
        if (gethostname(host, sizeof(host)) < 0) strcpy(host, "unknown");
        host[sizeof(host)-1] = 0;
        child_setenv("f", i->path); child_setenv("m", i->thumb_path); child_setenv("n", base);
        snprintf(num,sizeof(num),"%d",i->w); child_setenv("w",num);
        snprintf(num,sizeof(num),"%d",i->h); child_setenv("h",num);
        snprintf(num,sizeof(num),"%lld",(long long)i->w*(long long)i->h); child_setenv("p",num);
        snprintf(num,sizeof(num),"%zu",i->bytes); child_setenv("s",num);
        child_setenv("F",i->fmt); child_setenv("t",i->fmt); child_setenv("W",i->title); child_setenv("a",host);
        child_setenv("I3SHOT_FILE",i->path); child_setenv("I3SHOT_THUMB",i->thumb_path);
        child_setenv("I3SHOT_TITLE",i->title); child_setenv("I3SHOT_FORMAT",i->fmt);
        execl("/bin/sh","sh","-c",cmd,(char*)NULL);
        _exit(127);
    }
    (void)setpgid(pid, pid);
    int st = 0;
    for (;;) {
        pid_t r = waitpid(pid, &st, WNOHANG);
        if (r == pid) break;
        if (r < 0 && errno != EINTR) return -1;
        if (g_interrupted) {
            int sig = g_signal ? (int)g_signal : SIGTERM;
            (void)kill(-pid, sig);
            int64_t deadline = now_ms() + 2000;
            while (now_ms() < deadline) {
                r = waitpid(pid, &st, WNOHANG);
                if (r == pid) return 128 + sig;
                if (r < 0 && errno != EINTR) return 128 + sig;
                struct timespec ts = {0, 10000000}; nanosleep(&ts, NULL);
            }
            (void)kill(-pid, SIGKILL);
            while (waitpid(pid, &st, 0) < 0 && errno == EINTR) {}
            return 128 + sig;
        }
        struct timespec ts = {0, 10000000};
        nanosleep(&ts, NULL);
    }
    if (WIFEXITED(st)) return WEXITSTATUS(st);
    if (WIFSIGNALED(st)) return 128 + WTERMSIG(st);
    return 128;
}


