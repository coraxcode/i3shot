static void *dlopen_any(const char *const *names) {
    for (size_t i=0; names[i]; ++i) { void *h=dlopen(names[i],RTLD_LAZY|RTLD_LOCAL); if(h) return h; }
    return NULL;
}

static void xext_load(XExt *e) {
    memset(e,0,sizeof(*e));
    const char *fixes[]={"libXfixes.so.3","libXfixes.so",NULL};
    const char *randr[]={"libXrandr.so.2","libXrandr.so",NULL};
    const char *comp[]={"libXcomposite.so.1","libXcomposite.so",NULL};
    const char *shape[]={"libXext.so.6","libXext.so",NULL};
    e->fixes=dlopen_any(fixes); e->randr=dlopen_any(randr); e->composite=dlopen_any(comp); e->xshape=dlopen_any(shape);
    if(e->fixes) *(void **)(&e->XFixesGetCursorImage)=dlsym(e->fixes,"XFixesGetCursorImage");
    if(e->randr) {
        *(void **)(&e->XRRGetMonitors)=dlsym(e->randr,"XRRGetMonitors");
        *(void **)(&e->XRRFreeMonitors)=dlsym(e->randr,"XRRFreeMonitors");
    }
    if(e->composite) *(void **)(&e->XCompositeNameWindowPixmap)=dlsym(e->composite,"XCompositeNameWindowPixmap");
    if(e->xshape) {
        *(void **)(&e->XShapeQueryExtension)=dlsym(e->xshape,"XShapeQueryExtension");
        *(void **)(&e->XShapeCombineRectangles)=dlsym(e->xshape,"XShapeCombineRectangles");
    }
}

static void xext_close(XExt *e) {
    if (e->fixes) dlclose(e->fixes);
    if (e->randr) dlclose(e->randr);
    if (e->composite) dlclose(e->composite);
    if (e->xshape) dlclose(e->xshape);
    memset(e, 0, sizeof(*e));
}

/* ------------------------------ X11 helpers ------------------------------- */

typedef struct {
    Display *dpy;
    int screen;
    Window root;
    int root_w, root_h;
    XExt ext;
} XCtx;

static Atom atom(Display *d, const char *name) { return XInternAtom(d,name,False); }

static bool get_property(Display *d, Window w, Atom prop, Atom req_type,
                         unsigned char **data, unsigned long *nitems, Atom *actual_type, int *actual_format) {
    unsigned long after=0;
    /* 16 MiB worth of 32-bit units is far more than any property we read. */
    int st=XGetWindowProperty(d,w,prop,0,4L*1024*1024,False,req_type,actual_type,actual_format,nitems,&after,data);
    return st==Success && *data!=NULL;
}

static char *get_text_property_utf8(Display *d, Window w, const char *propname) {
    Atom actual; int fmt; unsigned long n=0; unsigned char *data=NULL;
    Atom utf8=atom(d,"UTF8_STRING");
    if(get_property(d,w,atom(d,propname),utf8,&data,&n,&actual,&fmt) && fmt==8) {
        char *s=xmalloc(n+1); memcpy(s,data,n); s[n]='\0'; XFree(data); return s;
    }
    if(data) XFree(data);
    XTextProperty tp;
    if (XGetWMName(d, w, &tp) && tp.value) {
        char *s = xmalloc((size_t)tp.nitems + 1);
        memcpy(s, tp.value, tp.nitems);
        s[tp.nitems] = '\0';
        XFree(tp.value);
        return s;
    }
    return xstrdup("");
}

static Window get_active_window(XCtx *x) {
    unsigned char *data=NULL; unsigned long n=0; Atom actual; int fmt;
    Window w=None;
    if(get_property(x->dpy,x->root,atom(x->dpy,"_NET_ACTIVE_WINDOW"),XA_WINDOW,&data,&n,&actual,&fmt) && n>=1 && fmt==32)
        w=*(Window*)data;
    if(data) XFree(data);
    if(w!=None) return w;                          /* honor EWMH only when meaningful */
    Window focus=None; int revert=0; XGetInputFocus(x->dpy,&focus,&revert); return focus;
}

static bool window_absolute_rect(XCtx *x, Window w, bool border, Rect *out) {
    XWindowAttributes a;
    if(!XGetWindowAttributes(x->dpy,w,&a) || a.map_state==IsUnmapped) return false;
    Window child=None; int rx=0,ry=0;
    if(!XTranslateCoordinates(x->dpy,w,x->root,0,0,&rx,&ry,&child)) return false;
    Rect r={rx,ry,a.width,a.height};
    if(border) {
        unsigned char *data=NULL; unsigned long n=0; Atom actual; int fmt;
        if(get_property(x->dpy,w,atom(x->dpy,"_NET_FRAME_EXTENTS"),XA_CARDINAL,&data,&n,&actual,&fmt) && n>=4 && fmt==32) {
            unsigned long *v=(unsigned long*)data;
            long l=(long)v[0],rr=(long)v[1],t=(long)v[2],b=(long)v[3];
            const long CAP=100000;                 /* reject absurd extents */
            if(l>=0&&l<=CAP&&rr>=0&&rr<=CAP&&t>=0&&t<=CAP&&b>=0&&b<=CAP){
                r.x-=(int)l; r.w+=(int)(l+rr); r.y-=(int)t; r.h+=(int)(t+b);
            }
            XFree(data);
        } else if(data) XFree(data);
    }
    r=rect_intersect(r,(Rect){0,0,x->root_w,x->root_h});
    if (!rect_valid(r)) return false;
    *out = r;
    return true;
}

static uint8_t component_from_mask(unsigned long pixel, unsigned long mask) {
    if(!mask) return 0;
    int shift=0; while(((mask>>shift)&1ul)==0ul && shift<(int)(sizeof(mask)*8-1)) ++shift;
    unsigned long max=mask>>shift, v=(pixel&mask)>>shift;
    return (uint8_t)((v*255ul + max/2ul)/max);
}

static unsigned long ximage_pixel_fast(const XImage *xi, int x, int y) {
    const uint8_t *p = (const uint8_t *)xi->data + (size_t)y * xi->bytes_per_line;
    int bpp = xi->bits_per_pixel;
    if (bpp == 32) {
        p += (size_t)x * 4;
        if (xi->byte_order == LSBFirst)
            return (unsigned long)p[0] | ((unsigned long)p[1] << 8) |
                   ((unsigned long)p[2] << 16) | ((unsigned long)p[3] << 24);
        return ((unsigned long)p[0] << 24) | ((unsigned long)p[1] << 16) |
               ((unsigned long)p[2] << 8) | (unsigned long)p[3];
    }
    if (bpp == 24) {
        p += (size_t)x * 3;
        if (xi->byte_order == LSBFirst)
            return (unsigned long)p[0] | ((unsigned long)p[1] << 8) | ((unsigned long)p[2] << 16);
        return ((unsigned long)p[0] << 16) | ((unsigned long)p[1] << 8) | (unsigned long)p[2];
    }
    if (bpp == 16) {
        p += (size_t)x * 2;
        if (xi->byte_order == LSBFirst) return (unsigned long)p[0] | ((unsigned long)p[1] << 8);
        return ((unsigned long)p[0] << 8) | (unsigned long)p[1];
    }
    return XGetPixel((XImage *)xi, x, y);
}

static Image ximage_to_rgb(XImage *xi, Rect crop) {
    crop = rect_intersect(crop, (Rect){0, 0, xi->width, xi->height});
    Image im = image_new(crop.w, crop.h);
    for (int y = 0; y < crop.h; ++y) {
        for (int x = 0; x < crop.w; ++x) {
            unsigned long p = ximage_pixel_fast(xi, crop.x + x, crop.y + y);
            uint8_t *q = im.rgb + ((size_t)y * crop.w + x) * 3;
            q[0] = component_from_mask(p, xi->red_mask);
            q[1] = component_from_mask(p, xi->green_mask);
            q[2] = component_from_mask(p, xi->blue_mask);
        }
    }
    return im;
}

static Image capture_root(XCtx *x, Rect r) {
    r=rect_intersect(r,(Rect){0,0,x->root_w,x->root_h});
    if(!rect_valid(r)) die("capture rectangle is outside the X11 root window");
    g_xerror=0;
    XImage *xi=XGetImage(x->dpy,x->root,r.x,r.y,(unsigned)r.w,(unsigned)r.h,AllPlanes,ZPixmap);
    XSync(x->dpy,False);
    if(!xi || g_xerror) die("XGetImage failed for %dx%d+%d+%d",r.w,r.h,r.x,r.y);
    Image im=ximage_to_rgb(xi,(Rect){0,0,r.w,r.h}); XDestroyImage(xi); return im;
}

static Image capture_window_content(XCtx *x, Window w, bool try_composite) {
    XWindowAttributes a;
    if(!XGetWindowAttributes(x->dpy,w,&a) || a.width<=0 || a.height<=0) die("cannot query window 0x%lx",w);
    Drawable dr=w; Pixmap pm=None;
    if(try_composite && x->ext.XCompositeNameWindowPixmap) {
        g_xerror=0; pm=x->ext.XCompositeNameWindowPixmap(x->dpy,w); XSync(x->dpy,False);
        if(!g_xerror && pm!=None) dr=pm; else pm=None;
    }
    g_xerror=0;
    XImage *xi=XGetImage(x->dpy,dr,0,0,(unsigned)a.width,(unsigned)a.height,AllPlanes,ZPixmap);
    XSync(x->dpy,False);
    if(pm!=None) XFreePixmap(x->dpy,pm);
    if(!xi || g_xerror) {
        if(xi) XDestroyImage(xi);                   /* don't leak a valid image on async error */
        Rect r; if(!window_absolute_rect(x,w,false,&r)) die("cannot capture window 0x%lx",w);
        return capture_root(x,r);
    }
    Image im=ximage_to_rgb(xi,(Rect){0,0,a.width,a.height}); XDestroyImage(xi); return im;
}

static void compose_cursor(XCtx *x, Image *im, Rect capture_rect) {
    if(!x->ext.XFixesGetCursorImage) { warnx("XFixes is unavailable; cursor was not captured"); return; }
    DynXFixesCursorImage *ci=x->ext.XFixesGetCursorImage(x->dpy);
    if(!ci) { warnx("XFixesGetCursorImage failed"); return; }
    int ox=(int)ci->x-(int)ci->xhot-capture_rect.x, oy=(int)ci->y-(int)ci->yhot-capture_rect.y;
    for(int y=0;y<(int)ci->height;++y) for(int xx=0;xx<(int)ci->width;++xx) {
        int dx=ox+xx,dy=oy+y; if(dx<0||dy<0||dx>=im->w||dy>=im->h) continue;
        unsigned long p=ci->pixels[(size_t)y*ci->width+xx];
        uint8_t a=(uint8_t)(p>>24), r=(uint8_t)(p>>16), g=(uint8_t)(p>>8), b=(uint8_t)p;
        uint8_t *q=im->rgb+((size_t)dy*im->w+dx)*3;
        /* XFixes pixels are premultiplied ARGB. */
        q[0]=(uint8_t)CLAMP((int)r + ((int)q[0]*(255-a)+127)/255,0,255);
        q[1]=(uint8_t)CLAMP((int)g + ((int)q[1]*(255-a)+127)/255,0,255);
        q[2]=(uint8_t)CLAMP((int)b + ((int)q[2]*(255-a)+127)/255,0,255);
    }
    XFree(ci);
}

static Rect *get_monitors(XCtx *x, int *count) {
    *count=0;
    if(x->ext.XRRGetMonitors && x->ext.XRRFreeMonitors) {
        int n=0; DynXRRMonitorInfo *mi=x->ext.XRRGetMonitors(x->dpy,x->root,True,&n);
        if(mi && n>0) {
            Rect *r=xcalloc((size_t)n,sizeof(*r));
            for(int i=0;i<n;++i) r[i]=(Rect){mi[i].x,mi[i].y,mi[i].width,mi[i].height};
            x->ext.XRRFreeMonitors(mi); *count=n; return r;
        }
        if(mi) x->ext.XRRFreeMonitors(mi);
    }
    Rect *r=xmalloc(sizeof(*r)); *r=(Rect){0,0,x->root_w,x->root_h}; *count=1; return r;
}

static Window window_at_point(XCtx *x, int px, int py) {
    unsigned char *data=NULL; unsigned long n=0; Atom actual; int fmt;
    if(get_property(x->dpy,x->root,atom(x->dpy,"_NET_CLIENT_LIST_STACKING"),XA_WINDOW,&data,&n,&actual,&fmt) && fmt==32) {
        Window *ws=(Window*)data;
        for(long i=(long)n-1;i>=0;--i) { Rect r; if(window_absolute_rect(x,ws[i],true,&r) && px>=r.x&&py>=r.y&&px<r.x+r.w&&py<r.y+r.h) { Window w=ws[i]; XFree(data); return w; } }
        XFree(data);
    } else if(data) XFree(data);
    Window rr,child=None; int rx,ry,wx,wy; unsigned mask;
    if(XQueryPointer(x->dpy,x->root,&rr,&child,&rx,&ry,&wx,&wy,&mask) && child!=None) return child;
    return x->root;
}

static bool window_class_matches(Display *d, Window w, const char *want) {
    if(!want||!*want) return true;
    XClassHint h={0}; bool ok=false;
    if(XGetClassHint(d,w,&h)) {
        ok=(h.res_name&&strcasecmp(h.res_name,want)==0)||(h.res_class&&strcasecmp(h.res_class,want)==0);
        if (h.res_name) XFree(h.res_name);
        if (h.res_class) XFree(h.res_class);
    }
    return ok;
}

static Image capture_stack_under_pointer(XCtx *x, bool vertical, const char *class_name, bool composite, Rect *logical_rect) {
    Window rr,child; int px,py,wx,wy; unsigned mask;
    if(!XQueryPointer(x->dpy,x->root,&rr,&child,&px,&py,&wx,&wy,&mask)) die("cannot query pointer");
    unsigned char *data=NULL; unsigned long n=0; Atom actual; int fmt;
    if(!get_property(x->dpy,x->root,atom(x->dpy,"_NET_CLIENT_LIST_STACKING"),XA_WINDOW,&data,&n,&actual,&fmt)||fmt!=32) die("_NET_CLIENT_LIST_STACKING is unavailable");
    Window *ws=(Window*)data; Window *sel=xcalloc(n?n:1,sizeof(Window)); int ns=0;
    for(unsigned long i=0;i<n;++i) {
        Rect r; if(window_absolute_rect(x,ws[i],false,&r)&&px>=r.x&&py>=r.y&&px<r.x+r.w&&py<r.y+r.h&&window_class_matches(x->dpy,ws[i],class_name)) { sel[ns++]=ws[i]; }
    }
    XFree(data); if(ns==0){free(sel);die("no matching windows are stacked under the pointer");}
    Image *parts=xcalloc((size_t)ns,sizeof(Image)); int64_t ow=0,oh=0;
    for(int i=0;i<ns;++i) { parts[i]=capture_window_content(x,sel[i],composite); if(vertical){if(parts[i].w>ow)ow=parts[i].w;oh+=parts[i].h;}else{ow+=parts[i].w;if(parts[i].h>oh)oh=parts[i].h;} }
    if(ow<=0||oh<=0||ow>100000||oh>100000){for(int i=0;i<ns;++i)image_free(&parts[i]);free(parts);free(sel);die("joined stack area is too large");}
    Image out=image_new((int)ow,(int)oh); int ox=0,oy=0;
    for(int i=0;i<ns;++i) { for(int y=0;y<parts[i].h;++y) memcpy(out.rgb+((size_t)(oy+y)*(size_t)ow+(size_t)ox)*3,parts[i].rgb+(size_t)y*parts[i].w*3,(size_t)parts[i].w*3); if(vertical)oy+=parts[i].h;else ox+=parts[i].w; image_free(&parts[i]); }
    free(parts);free(sel); *logical_rect=(Rect){0,0,(int)ow,(int)oh}; return out;
}

/* ------------------------------- i3 IPC ----------------------------------- */

typedef enum { JT_UNDEF, JT_OBJECT, JT_ARRAY, JT_STRING, JT_PRIMITIVE } JType;
typedef struct { JType type; int start,end,size,parent; } JTok;

typedef struct { unsigned pos,next; int super; } JParser;

static int json_parse(const char *js,size_t len,JTok **out) {
    size_t cap=512,n=0; JTok *t=xcalloc(cap,sizeof(*t)); JParser p={0,0,-1};
#define NEWTOK() (n==cap?(cap*=2,t=xrealloc(t,cap*sizeof(*t))):t, &t[n++])
    while(p.pos<len) {
        char c=js[p.pos];
        if(c=='{'||c=='[') { JTok *q=NEWTOK(); *q=(JTok){c=='{'?JT_OBJECT:JT_ARRAY,(int)p.pos,-1,0,p.super}; if(p.super>=0)t[p.super].size++; p.super=(int)n-1; p.pos++; continue; }
        if(c=='}'||c==']') { JType want=c=='}'?JT_OBJECT:JT_ARRAY; int i=(int)n-1; for(;i>=0;--i)if(t[i].start>=0&&t[i].end<0){if(t[i].type!=want){free(t);return -1;}t[i].end=(int)p.pos+1;p.super=t[i].parent;break;}if(i<0){free(t);return -1;}p.pos++;continue; }
        if(c=='\"') { size_t st=++p.pos; bool ok=false; while(p.pos<len){c=js[p.pos];if(c=='\"'){ok=true;break;}if(c=='\\'){p.pos++;if(p.pos>=len)break;}p.pos++;}if(!ok){free(t);return -1;}JTok*q=NEWTOK();*q=(JTok){JT_STRING,(int)st,(int)p.pos,0,p.super};if(p.super>=0)t[p.super].size++;p.pos++;continue; }
        if(isspace((unsigned char)c)||c==':'||c==','){p.pos++;continue;}
        size_t st=p.pos;while(p.pos<len&&!isspace((unsigned char)js[p.pos])&&strchr(",]}:",js[p.pos])==NULL)p.pos++;JTok*q=NEWTOK();*q=(JTok){JT_PRIMITIVE,(int)st,(int)p.pos,0,p.super};if(p.super>=0)t[p.super].size++;
    }
