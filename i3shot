                warnx("unknown extension '%s'; writing %s data", ext, format_name(fmt));
        } else {
            bool ext_bmp = ext && (!strcasecmp(ext, ".bmp") || !strcasecmp(ext, ".dib"));
            bool ext_png = ext && !strcasecmp(ext, ".png");
            if ((fmt == FMT_BMP && ext_png) || (fmt == FMT_PNG && ext_bmp))
                warnx("--format %s does not match extension '%s'", format_name(fmt), ext);
