static Rect parse_rect_arg(const char*s){
    long v[4]; const char*e=s;
    for(int i=0;i<4;++i){
        if(i){ if(*e!=',') die("invalid rectangle '%s'; expected X,Y,W,H",s); ++e; }
        char*ne; errno=0; long x=strtol(e,&ne,10);
