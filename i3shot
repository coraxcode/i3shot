    struct stat st; if (strcmp(path, "-") && stat(path, &st) == 0) ei.bytes = (size_t)st.st_size;
    if (o.exec_cmd && strcmp(path, "-")) { int rc = run_post_command(o.exec_cmd, &ei); if (rc != 0) warnx("post command exited with status %d", rc); }
    if (!o.silent && strcmp(path, "-")) {
        fprintf(stderr, "Saved %s (%dx%d, %zu bytes)\n", path, image.w, image.h, ei.bytes);
        if (isatty(STDERR_FILENO)) fputc('\a', stderr);   /* bell only on a real terminal (L06) */
