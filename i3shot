static char *x11_i3_socket(XCtx*x){unsigned char*data=NULL;unsigned long n=0;Atom actual;int fmt;if(get_property(x->dpy,x->root,atom(x->dpy,"I3_SOCKET_PATH"),AnyPropertyType,&data,&n,&actual,&fmt)&&fmt==8){char*s=xmalloc(n+1);memcpy(s,data,n);s[n]=0;XFree(data);return s;}if(data)XFree(data);return NULL;}

