static volatile sig_atomic_t g_interrupted = 0;
static volatile sig_atomic_t g_signal = 0;
static int g_xerror = 0;
static int g_sigpipe[2] = { -1, -1 };            /* self-pipe for signal wakeups */

static void on_signal(int sig) {
    int saved_errno = errno;
    g_interrupted = 1;
    g_signal = sig;
    if (g_sigpipe[1] >= 0) {
        const unsigned char c = 1;
        ssize_t r = write(g_sigpipe[1], &c, 1);
        (void)r;
    }
    errno = saved_errno;
}

/* Install interruptible handlers (no SA_RESTART) plus a nonblocking self-pipe
   so blocking waits on X11 or IPC can be woken by SIGINT/SIGTERM. */
static void install_signals(void) {
#ifdef __linux__
    if (pipe2(g_sigpipe, O_NONBLOCK | O_CLOEXEC) < 0) {
        perror("i3shot: pipe2");
        exit(EXIT_FAILURE);
    }
#else
    if (pipe(g_sigpipe) < 0) {
        perror("i3shot: pipe");
        exit(EXIT_FAILURE);
    }
    for (int i = 0; i < 2; ++i) {
        int fl = fcntl(g_sigpipe[i], F_GETFL, 0);
        if (fl < 0 || fcntl(g_sigpipe[i], F_SETFL, fl | O_NONBLOCK) < 0) {
            perror("i3shot: fcntl(O_NONBLOCK)");
            exit(EXIT_FAILURE);
        }
        fl = fcntl(g_sigpipe[i], F_GETFD, 0);
        if (fl < 0 || fcntl(g_sigpipe[i], F_SETFD, fl | FD_CLOEXEC) < 0) {
            perror("i3shot: fcntl(FD_CLOEXEC)");
            exit(EXIT_FAILURE);
        }
    }
#endif
    struct sigaction sa;
    memset(&sa, 0, sizeof(sa));
    sa.sa_handler = on_signal;                    /* no SA_RESTART: syscalls return EINTR */
    sigemptyset(&sa.sa_mask);
    if (sigaction(SIGINT, &sa, NULL) < 0 || sigaction(SIGTERM, &sa, NULL) < 0) {
        perror("i3shot: sigaction");
        exit(EXIT_FAILURE);
    }
    memset(&sa, 0, sizeof(sa));
    sa.sa_handler = SIG_IGN;
    if (sigaction(SIGPIPE, &sa, NULL) < 0) {
        perror("i3shot: sigaction(SIGPIPE)");
        exit(EXIT_FAILURE);
    }
}

static int xerror_handler(Display *d, XErrorEvent *e) {
    (void)d;
    g_xerror = e->error_code ? e->error_code : 1;
