/* Frozen mode: erase the previous border from the snapshot-backed overlay and
   draw the current one. Only the thin border strips are touched, so it never
   flickers and never repaints the whole screen. */
static void sel_freeze_draw(Display *d, Window ov, GC gc, Rect prev, Rect cur, int lw) {
    int h = lw + 2;                                  /* erase band thickness */
    if (rect_valid(prev)) {                          /* restore snapshot under old border */
        XClearArea(d, ov, prev.x - h, prev.y - h, (unsigned)(prev.w + 2 * h), (unsigned)(2 * h), False);
        XClearArea(d, ov, prev.x - h, prev.y + prev.h - h, (unsigned)(prev.w + 2 * h), (unsigned)(2 * h), False);
        XClearArea(d, ov, prev.x - h, prev.y - h, (unsigned)(2 * h), (unsigned)(prev.h + 2 * h), False);
        XClearArea(d, ov, prev.x + prev.w - h, prev.y - h, (unsigned)(2 * h), (unsigned)(prev.h + 2 * h), False);
    }
    if (rect_valid(cur))
        XDrawRectangle(d, ov, gc, cur.x, cur.y, (unsigned)MAX2(0, cur.w - 1), (unsigned)MAX2(0, cur.h - 1));
}

/* Live mode: shape the transparent overlay so only the rubber-band border is a
   real window; the live desktop shows through everywhere else. The border can
   therefore never appear in the captured root image. */
static void sel_live_shape(const XExt *e, Display *d, Window ov, Rect r, int lw) {
    if (!rect_valid(r)) {                             /* nothing selected yet: hide overlay */
        e->XShapeCombineRectangles(d, ov, I3_SHAPE_BOUNDING, 0, 0, NULL, 0, I3_SHAPE_SET, I3_SHAPE_UNSORTED);
        XClearWindow(d, ov);
        return;
    }
    int w = MAX2(1, MIN2(lw, r.w)), h = MAX2(1, MIN2(lw, r.h));
    XRectangle bars[4] = {
        { (short)r.x,             (short)r.y,               (unsigned short)r.w, (unsigned short)h },
        { (short)r.x,             (short)(r.y + r.h - h),   (unsigned short)r.w, (unsigned short)h },
        { (short)r.x,             (short)r.y,               (unsigned short)w,   (unsigned short)r.h },
        { (short)(r.x + r.w - w), (short)r.y,               (unsigned short)w,   (unsigned short)r.h },
    };
    e->XShapeCombineRectangles(d, ov, I3_SHAPE_BOUNDING, 0, 0, bars, 4, I3_SHAPE_SET, I3_SHAPE_UNSORTED);
    XClearWindow(d, ov);                             /* paint visible border with bg colour */
}

/* Interactive rectangle/window selection.
 *
 * The rubber band is always drawn on a dedicated override-redirect overlay,
 * never on the root window, so it cannot leak into the screenshot. Two render
 * modes are used:
 *   - live  (default): SHAPE-clipped transparent overlay over the live desktop.
 *   - freeze (-f, or when SHAPE is missing): opaque overlay showing a snapshot;
 *     the caller crops the final image from that clean snapshot.
 * On success with a snapshot, *frozen_image receives it; the caller owns it.
 */
static bool interactive_select(XCtx *x, bool freeze, bool ignore_keyboard,
                               const SelectStyle *st, Rect *out, Window *clicked,
                               XImage **frozen_image) {
    Display *d = x->dpy;
    *clicked = None;
    if (frozen_image) *frozen_image = NULL;

    /* Pick render mode. SHAPE is required for a transparent live overlay. */
    int seb = 0, ser = 0;
    bool shape_ok = x->ext.XShapeQueryExtension && x->ext.XShapeCombineRectangles &&
                    x->ext.XShapeQueryExtension(d, &seb, &ser);
    bool use_freeze = freeze || !shape_ok;

    XImage *snap = NULL;
    if (use_freeze) {                                /* need a clean snapshot to draw over */
        snap = XGetImage(d, x->root, 0, 0, (unsigned)x->root_w, (unsigned)x->root_h, AllPlanes, ZPixmap);
        if (!snap) {                                 /* fall back to live if snapshot fails */
            if (shape_ok) use_freeze = false;
            else { warnx("cannot snapshot the screen for selection"); return false; }
        }
    }

    /* Create the override-redirect overlay covering the whole root. */
    XSetWindowAttributes a; memset(&a, 0, sizeof(a));
    a.override_redirect = True;
    a.background_pixel = st->pixel;                  /* live border colour */
    a.border_pixel = 0;
    a.event_mask = ExposureMask;
    Window ov = XCreateWindow(d, x->root, 0, 0, (unsigned)x->root_w, (unsigned)x->root_h, 0,
                              CopyFromParent, InputOutput, CopyFromParent,
                              CWOverrideRedirect | CWBackPixel | CWBorderPixel | CWEventMask, &a);
    if (ov == None) { if (snap) XDestroyImage(snap); warnx("cannot create selection overlay"); return false; }

    Pixmap bg = None;
    if (use_freeze) {                                /* back overlay with the snapshot */
        bg = XCreatePixmap(d, x->root, (unsigned)x->root_w, (unsigned)x->root_h,
                           (unsigned)DefaultDepth(d, x->screen));
        GC pg = XCreateGC(d, bg, 0, NULL);
        XPutImage(d, bg, pg, snap, 0, 0, 0, 0, (unsigned)x->root_w, (unsigned)x->root_h);
        XFreeGC(d, pg);
        XSetWindowBackgroundPixmap(d, ov, bg);
    } else {                                         /* start hidden until first drag */
        x->ext.XShapeCombineRectangles(d, ov, I3_SHAPE_BOUNDING, 0, 0, NULL, 0, I3_SHAPE_SET, I3_SHAPE_UNSORTED);
    }
    XMapRaised(d, ov);
    XClearWindow(d, ov);
    XSync(d, False);

    /* Grab input for the whole gesture. */
    Cursor cur = XCreateFontCursor(d, XC_crosshair);
    if (XGrabPointer(d, x->root, False, ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
                     GrabModeAsync, GrabModeAsync, x->root, cur, CurrentTime) != GrabSuccess) {
        XFreeCursor(d, cur);
        if (bg) XFreePixmap(d, bg);
        XDestroyWindow(d, ov);
        if (snap) XDestroyImage(snap);
        warnx("cannot grab the pointer for selection");
        return false;
    }
    XGrabKeyboard(d, x->root, False, GrabModeAsync, GrabModeAsync, CurrentTime);

    /* Colour GC used only by the frozen-mode border. */
    GC gc = None;
    if (use_freeze) {
        XGCValues gv; memset(&gv, 0, sizeof(gv));
        gv.foreground = st->pixel;
        gc = XCreateGC(d, ov, GCForeground, &gv);
        XSetLineAttributes(d, gc, (unsigned)st->width, st->line_style, CapButt, JoinMiter);
        if (st->line_style == LineOnOffDash) { char dash[2] = {6, 4}; XSetDashes(d, gc, 0, dash, 2); }
    }

    bool dragging = false, have = false, cancel = false;
    int x1 = 0, y1 = 0, x2 = 0, y2 = 0;
    Rect shown = {0};                                /* currently displayed rect */

    while (!g_interrupted && !cancel && !have) {
        XEvent e; XNextEvent(d, &e);
        switch (e.type) {
        case ButtonPress:
            if (e.xbutton.button == Button1) {
                dragging = true;
                x1 = x2 = e.xbutton.x_root; y1 = y2 = e.xbutton.y_root;
            }
            break;
        case MotionNotify:
            if (dragging) {
                while (XCheckTypedEvent(d, MotionNotify, &e)) {}   /* coalesce motion */
                x2 = e.xmotion.x_root; y2 = e.xmotion.y_root;
                Rect nr = rect_normalize(x1, y1, x2, y2);
                if (use_freeze) sel_freeze_draw(d, ov, gc, shown, nr, st->width);
                else            sel_live_shape(&x->ext, d, ov, nr, st->width);
                shown = nr; XFlush(d);
            }
            break;
        case ButtonRelease:
            if (dragging && e.xbutton.button == Button1) {
                x2 = e.xbutton.x_root; y2 = e.xbutton.y_root;
                Rect r = rect_normalize(x1, y1, x2, y2);
                if (r.w <= 3 && r.h <= 3) {           /* tiny drag: treat as a window click */
                    *clicked = window_at_point(x, x2, y2);
                    window_absolute_rect(x, *clicked, false, &r);
                }
                *out = r; have = true;
            }
            break;
        case KeyPress: {
            KeySym ks = XLookupKeysym(&e.xkey, 0);
            if (ks == XK_Escape) { cancel = true; break; }
            if (ignore_keyboard) break;
            if ((ks == XK_Return || ks == XK_KP_Enter) && dragging) {
                *out = rect_normalize(x1, y1, x2, y2); have = true;
            } else if (dragging && (ks == XK_Left || ks == XK_Right || ks == XK_Up || ks == XK_Down)) {
                int step = (e.xkey.state & ShiftMask) ? 10 : 1;
                if (ks == XK_Left)  x2 -= step;
                if (ks == XK_Right) x2 += step;
                if (ks == XK_Up)    y2 -= step;
                if (ks == XK_Down)  y2 += step;
                Rect nr = rect_normalize(x1, y1, x2, y2);
                if (use_freeze) sel_freeze_draw(d, ov, gc, shown, nr, st->width);
                else            sel_live_shape(&x->ext, d, ov, nr, st->width);
                shown = nr; XFlush(d);
            }
            break;
        }
        case Expose:
            if (use_freeze && rect_valid(shown))     /* keep border after a repaint */
                XDrawRectangle(d, ov, gc, shown.x, shown.y,
                               (unsigned)MAX2(0, shown.w - 1), (unsigned)MAX2(0, shown.h - 1));
            break;
        default: break;
        }
    }

    /* Tear the overlay down and make the screen pristine before any capture. */
    XUngrabKeyboard(d, CurrentTime);
    XUngrabPointer(d, CurrentTime);
    if (gc) XFreeGC(d, gc);
    XFreeCursor(d, cur);
    XUnmapWindow(d, ov);
    XDestroyWindow(d, ov);
    if (bg) XFreePixmap(d, bg);
    XSync(d, True);                                  /* apply destroy, drop stale events */

    bool ok = have && !cancel && !g_interrupted;
    if (ok && use_freeze && frozen_image) {
        *frozen_image = snap;                        /* caller crops from clean snapshot */
    } else {
        if (snap) XDestroyImage(snap);
        if (ok && !use_freeze) {                     /* let a compositor repaint the freed strips */
            sleep_seconds(0.03);
            XSync(d, False);
        }
    }
    return ok;
}

/* ------------------------- naming, output, command ------------------------ */

typedef enum { FMT_AUTO, FMT_PNG, FMT_BMP } Format;

typedef struct {
    const char *path,*thumb_path,*title,*fmt;
    int w,h; size_t bytes;
} ExpandInfo;

static char *str_replace_vars(const char *in,const ExpandInfo*i,bool shell_quote_values);

static char *shell_quote(const char*s){Buf b={0};buf_u8(&b,'\'');for(;*s;++s){if(*s=='\'')buf_put(&b,"'\\''",4);else buf_u8(&b,(uint8_t)*s);}buf_u8(&b,'\'');buf_u8(&b,0);return(char*)b.p;}

static char *str_replace_vars(const char *in,const ExpandInfo*i,bool quote){Buf b={0};char num[64];for(size_t p=0;in[p];++p){if(in[p]=='$'){char c=in[p+1];const char*v=NULL;switch(c){case'$':buf_u8(&b,'$');p++;continue;case'f':v=i->path;break;case'm':v=i->thumb_path;break;case'n':{const char*q=i->path?strrchr(i->path,'/'):NULL;v=q?q+1:i->path;}break;case'w':snprintf(num,sizeof(num),"%d",i->w);v=num;break;case'h':snprintf(num,sizeof(num),"%d",i->h);v=num;break;case'p':snprintf(num,sizeof(num),"%d",i->w*i->h);v=num;break;case's':snprintf(num,sizeof(num),"%zu",i->bytes);v=num;break;case'F':case't':v=i->fmt;break;case'W':v=i->title;break;case'a':{static char host[256];if(gethostname(host,sizeof(host))<0)strcpy(host,"unknown");host[sizeof(host)-1]=0;v=host;}break;default:buf_u8(&b,'$');continue;}if(v){char*q=quote?shell_quote(v):xstrdup(v);buf_put(&b,q,strlen(q));free(q);p++;continue;}}if(in[p]=='\\'&&in[p+1]=='n'){buf_u8(&b,'\n');p++;}else buf_u8(&b,(uint8_t)in[p]);}buf_u8(&b,0);return(char*)b.p;}

static char *expand_filename(const char *pattern,const ExpandInfo*i){char timebuf[PATH_MAX*2];time_t now=time(NULL);struct tm tm;localtime_r(&now,&tm);if(!strftime(timebuf,sizeof(timebuf),pattern,&tm))die("expanded filename is too long");return str_replace_vars(timebuf,i,false);}

static const char *format_name(Format f){return f==FMT_BMP?"bmp":"png";}
static Format parse_format(const char*s){if(!s||!*s)return FMT_AUTO;if(!strcasecmp(s,"png"))return FMT_PNG;if(!strcasecmp(s,"bmp"))return FMT_BMP;die("unsupported format '%s' (supported: png, bmp)",s);return FMT_AUTO;}
static Format format_from_path(const char*p){if(!p||!strcmp(p,"-"))return FMT_PNG;const char*e=strrchr(p,'.');if(e&&(!strcasecmp(e,".bmp")||!strcasecmp(e,".dib")))return FMT_BMP;return FMT_PNG;}

static char *thumbnail_path(const char *path){if(!path||!strcmp(path,"-"))return NULL;const char*slash=strrchr(path,'/');const char*dot=strrchr(path,'.');if(dot&&(!slash||dot>slash)){size_t a=(size_t)(dot-path);char*out=xmalloc(strlen(path)+7);memcpy(out,path,a);strcpy(out+a,"_thumb");strcat(out,dot);return out;}char*out=xmalloc(strlen(path)+11);sprintf(out,"%s_thumb.png",path);return out;}

static bool save_bytes_atomic(const char*path,const uint8_t*data,size_t n,bool overwrite,mode_t mode){if(!strcmp(path,"-"))return write_all_fd(STDOUT_FILENO,data,n);struct stat st;if(!overwrite&&lstat(path,&st)==0){errno=EEXIST;return false;}char tmp[PATH_MAX];if(snprintf(tmp,sizeof(tmp),"%s.tmp.XXXXXX",path)>=(int)sizeof(tmp)){errno=ENAMETOOLONG;return false;}int fd=mkstemp(tmp);if(fd<0)return false;bool ok=fchmod(fd,mode)==0&&write_all_fd(fd,data,n)&&fsync(fd)==0;if(close(fd)<0)ok=false;if(ok){if(!overwrite&&link(tmp,path)==0){unlink(tmp);return true;}if(!overwrite){if(errno==EEXIST){unlink(tmp);return false;}/* link may fail on unusual FS; fall through with guarded rename */if(lstat(path,&st)==0){unlink(tmp);errno=EEXIST;return false;}}if(rename(tmp,path)<0)ok=false;}if(!ok)unlink(tmp);return ok;}

/* Build "stem-N.ext" from path (append "-N" when there is no extension). */
static char *indexed_path(const char *path, int n) {
    const char *slash = strrchr(path, '/');
    const char *dot = strrchr(path, '.');
    size_t stem = (dot && (!slash || dot > slash)) ? (size_t)(dot - path) : strlen(path);
    char *out = xmalloc(strlen(path) + 32);
    sprintf(out, "%.*s-%d%s", (int)stem, path, n, path + stem);
    return out;
}

/* Save without ever overwriting: on collision pick the next free "name-N.ext".
   Each attempt is atomic, so rapid or concurrent captures never clobber a file
   and never fail. On success *path_io is updated to the name actually used. */
static bool save_unique(char **path_io, const uint8_t *data, size_t n, bool overwrite, mode_t mode) {
    if (overwrite || !strcmp(*path_io, "-"))
        return save_bytes_atomic(*path_io, data, n, overwrite, mode);
    if (save_bytes_atomic(*path_io, data, n, false, mode)) return true;
    if (errno != EEXIST) return false;
    for (int i = 1; i < 1000000; ++i) {
        char *cand = indexed_path(*path_io, i);
        if (save_bytes_atomic(cand, data, n, false, mode)) { free(*path_io); *path_io = cand; return true; }
        int e = errno; free(cand);
        if (e != EEXIST) { errno = e; return false; }
    }
    errno = EEXIST;
    return false;
}

static int run_post_command(const char*cmd,const ExpandInfo*i){char*expanded=str_replace_vars(cmd,i,true);pid_t pid=fork();if(pid<0){free(expanded);return -1;}if(pid==0){execl("/bin/sh","sh","-c",expanded,(char*)NULL);_exit(127);}free(expanded);int st;while(waitpid(pid,&st,0)<0&&errno==EINTR){}return WIFEXITED(st)?WEXITSTATUS(st):128;}

