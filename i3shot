        case 's': o.target = T_SELECT; free(o.select_opts); o.select_opts = xstrdup(optarg ? optarg : "capture"); parse_select_opts(&o, optarg); break;
        case 't': parse_thumb(&o, optarg); break;
        case 'u': o.target = T_FOCUSED; break;
        case 'v': printf("i3shot %s\n", I3SHOT_VERSION); exit(0);
        case 'w': { unsigned long v; if (!parse_ulong_strict(optarg, 0xFFFFFFFFUL, &v) || v == 0) die("invalid window ID '%s'", optarg); o.target = T_WINDOW; o.window = (Window)v; } break;
        case 'Z': { int v; if (!parse_int_strict(optarg, 0, 9, &v)) die("compression must be 0..9"); o.compression = v; } break;
        case 'z': o.silent = true; break;
        case OPT_FORMAT: free(o.format_str); o.format_str = xstrdup(optarg); break;
        case OPT_LIST:
            if (!optarg) { usage(stdout); exit(0); }
            if (!strcmp(optarg, "tsv")) {
                for (const struct option *op = lo; op->name; ++op)
                    printf("%s\t%s\n", op->name,
                           op->has_arg == required_argument ? "arg" :
                           op->has_arg == optional_argument ? "optional" : "none");
                exit(0);
            }
            die("unknown --list-options format '%s' (supported: tsv)", optarg);
        case OPT_CONTAINER: o.target = T_I3_CONTAINER; break;
        case OPT_WORKSPACE: o.target = T_I3_WORKSPACE; break;
        case OPT_OUTPUT: if (strcmp(optarg, "current")) die("only --output current is supported"); o.target = T_I3_OUTPUT; break;
        case OPT_FULL: o.target = T_FULL; break;
        case OPT_COMPOSITE: o.composite = true; break;
        case '?': default: die("unknown or malformed option; use --help");
        }
    }
    if(optind<argc){if(o.filename)die("output file specified more than once");o.filename=xstrdup(argv[optind++]);}if(optind<argc)die("too many arguments");if(!o.filename)o.filename=xstrdup("%Y-%m-%d_%H-%M-%S_$wx$h.png");return o;}

static void options_free(Options*o){free(o->display);free(o->exec_cmd);free(o->class_name);free(o->line_style);free(o->select_opts);free(o->format_str);free(o->filename);}

static void countdown(const Options *o) {
    if (o->delay <= 0) return;
    if (!o->count) {
        sleep_seconds(o->delay);
        return;
    }
    int whole = (int)floor(o->delay);
    double rem = o->delay - whole;
    for (int i = whole; i > 0 && !g_interrupted; --i) {
        fprintf(stderr, "\rScreenshot in %d... ", i);
        fflush(stderr);
        sleep_seconds(1.0);
    }
    if (rem > 0 && !g_interrupted) sleep_seconds(rem);
    fprintf(stderr, "\r%*s\r", 32, "");
    fflush(stderr);
}

static Image join_monitors(XCtx*x,Rect*mons,int n,Rect*logical){
    int64_t w=0,h=0;
    for(int i=0;i<n;++i){w+=mons[i].w; if(mons[i].h>h)h=mons[i].h;}
    if(w<=0||h<=0||w>100000||h>100000)die("joined monitor area is too large");
    Image out=image_new((int)w,(int)h);int ox=0;
    for(int i=0;i<n;++i){Image p=capture_root(x,mons[i]);for(int y=0;y<p.h;++y)memcpy(out.rgb+((size_t)y*(size_t)w+(size_t)ox)*3,p.rgb+(size_t)y*p.w*3,(size_t)p.w*3);image_free(&p);ox+=mons[i].w;}
    *logical=(Rect){0,0,(int)w,(int)h};return out;
}

static char *window_title_for_target(XCtx*x,Window w){if(w==None||w==x->root)return xstrdup("");return get_text_property_utf8(x->dpy,w,"_NET_WM_NAME");}

int main(int argc, char **argv) {
    install_signals();
    XSetErrorHandler(xerror_handler);
    Options o = parse_options(argc, argv);
    Format forced = parse_format(o.format_str);
    Display *d = XOpenDisplay(o.display);
    if (!d) die("cannot open X display '%s'", o.display ? o.display : (getenv("DISPLAY") ? getenv("DISPLAY") : "(unset)"));

    XCtx x = {0};
    x.dpy = d; x.screen = DefaultScreen(d); x.root = RootWindow(d, x.screen); x.display_explicit = o.display != NULL;
    if (!refresh_root_geometry(&x)) die("cannot query the X11 root window");
    xext_load(&x.ext);
    xext_probe(&x);

    SelectStyle ss;
    parse_line_style(&x, o.line_style, &ss);
    Rect cap = {0,0,x.root_w,x.root_h};
    Window target_win = None;
    char *title = NULL;
    Image image = {0};
    bool image_ready = false;
    XImage *frozen = NULL;

    if (o.delay_before_select) countdown(&o);
    else if (o.target != T_SELECT) countdown(&o);
    if (g_interrupted) { options_free(&o); XCloseDisplay(d); xext_close(&x.ext); return 128 + (g_signal ? g_signal : SIGINT); }
    if (!refresh_root_geometry(&x)) die("cannot refresh the X11 root geometry");
    cap = (Rect){0,0,x.root_w,x.root_h};

    switch (o.target) {
    case T_FULL:
        break;
    case T_AREA:
        cap = o.area;
        break;
    case T_FOCUSED:
        target_win = get_active_window(&x);
        if (target_win == None) die("no focused X11 window");
        if (o.composite && !o.border) {
            image = capture_window_content(&x, target_win, true);
            image_ready = true; cap = (Rect){0,0,image.w,image.h};
        } else if (!(o.border && i3_window_rect(&x, target_win, &cap)) &&
                   !window_absolute_rect(&x, target_win, o.border, &cap)) {
            die("cannot determine focused window geometry");
        }
        break;
    case T_WINDOW:
        target_win = o.window;
        if (!window_is_capture_candidate(&x, target_win)) die("window 0x%lx is not a mapped captureable window", target_win);
        if (o.composite && !o.border) {
            image = capture_window_content(&x, target_win, true);
            image_ready = true; cap = (Rect){0,0,image.w,image.h};
        } else if (!(o.border && i3_window_rect(&x, target_win, &cap)) &&
                   !window_absolute_rect(&x, target_win, o.border, &cap)) {
            die("cannot determine window geometry");
        }
        break;
    case T_MONITOR: {
        if (!x.randr_ok) die("XRandR 1.5 monitor discovery is unavailable; refusing to guess monitor geometry");
        int n = 0; Rect *m = get_monitors(&x, &n);
        if (!m || n <= 0) die("cannot obtain monitor geometry from XRandR");
        if (o.monitor < 0 || o.monitor >= n) { free(m); die("monitor %d does not exist; available range is 0..%d",o.monitor,n-1); }
        cap = m[o.monitor]; free(m); break;
    }
    case T_MULTI: {
        if (!x.randr_ok) die("XRandR 1.5 monitor discovery is unavailable; cannot capture multiple monitors");
        int n = 0; Rect *m = get_monitors(&x, &n);
        if (!m || n <= 0) die("cannot obtain monitor geometry from XRandR");
        image = join_monitors(&x,m,n,&cap); image_ready = true; free(m); break;
    }
    case T_STACK:
        image = capture_stack_under_pointer(&x,o.stack_vertical,o.class_name,true,&cap); image_ready = true; break;
    case T_I3_CONTAINER:
        if (!i3_tree_target(&x,"container",&cap,&target_win,&title)) die("cannot obtain focused container from i3 IPC: %s",i3_error_text());
        break;
    case T_I3_WORKSPACE:
        if (!i3_tree_target(&x,"workspace",&cap,NULL,&title)) die("cannot obtain focused workspace from i3 IPC: %s",i3_error_text());
        break;
    case T_I3_OUTPUT:
        if (!i3_current_output(&x,&cap)) die("cannot obtain current output from i3 IPC: %s",i3_error_text());
        break;
    case T_SELECT: {
        Window clicked = None;
        if (!interactive_select(&x,o.freeze,o.ignore_keyboard,&ss,&cap,&clicked,&frozen)) {
            int rc = g_interrupted ? 128 + (g_signal ? g_signal : SIGINT) : 1;
            options_free(&o); XCloseDisplay(d); xext_close(&x.ext); return rc;
        }
        target_win = clicked;
        if (clicked != None && o.border && !i3_window_rect(&x,clicked,&cap) &&
            !window_absolute_rect(&x,clicked,true,&cap)) die("cannot determine selected window border geometry");
        break;
    }
    }

    if (!o.delay_before_select && o.target == T_SELECT) countdown(&o);
    if (g_interrupted) {
        if (frozen) XDestroyImage(frozen);
        options_free(&o); XCloseDisplay(d); xext_close(&x.ext);
        return 128 + (g_signal ? g_signal : SIGINT);
    }

    Rect root_bounds;
    if (frozen) root_bounds = (Rect){0,0,frozen->width,frozen->height};
    else {
        if (!refresh_root_geometry(&x)) die("cannot refresh the X11 root geometry before capture");
        root_bounds = (Rect){0,0,x.root_w,x.root_h};
    }
    Rect selected_rect = cap, cursor_rect = cap;
    bool cursor_has_root_mapping = false;

    if (o.target == T_SELECT && o.select_mode != SM_CAPTURE) {
        selected_rect = rect_intersect(selected_rect,root_bounds);
        if (!rect_valid(selected_rect)) die("selected rectangle is empty after clipping");
        if (frozen) { image=ximage_to_rgb(&x,frozen,root_bounds); XDestroyImage(frozen); frozen=NULL; }
        else image=capture_root(&x,root_bounds);
        cap=root_bounds; cursor_rect=root_bounds; cursor_has_root_mapping=true;
    } else if (!image_ready) {
        cap=rect_intersect(cap,root_bounds);
        if (!rect_valid(cap)) die("capture rectangle is empty after clipping");
        if (frozen) { image=ximage_to_rgb(&x,frozen,cap); XDestroyImage(frozen); frozen=NULL; }
        else image=capture_root(&x,cap);
        cursor_rect=cap; cursor_has_root_mapping=true;
    } else if (o.composite && (o.target==T_WINDOW || o.target==T_FOCUSED)) {
        Rect wr; if (window_absolute_rect(&x,target_win,false,&wr)) { cursor_rect=wr; cursor_has_root_mapping=(wr.w==image.w&&wr.h==image.h); }
    }

    if (o.pointer) {
        if (cursor_has_root_mapping) compose_cursor(&x,&image,cursor_rect);
        else warnx("cursor capture is unavailable for this joined target");
    }

    if (o.target==T_SELECT && o.select_mode!=SM_CAPTURE) {
        Rect local=selected_rect;
        if (o.select_mode==SM_HOLE) {
            image_fill_rect(&image,(Rect){0,0,image.w,local.y},ss.r,ss.g,ss.b,ss.opacity);
            image_fill_rect(&image,(Rect){0,local.y+local.h,image.w,image.h-(local.y+local.h)},ss.r,ss.g,ss.b,ss.opacity);
            image_fill_rect(&image,(Rect){0,local.y,local.x,local.h},ss.r,ss.g,ss.b,ss.opacity);
            image_fill_rect(&image,(Rect){local.x+local.w,local.y,image.w-(local.x+local.w),local.h},ss.r,ss.g,ss.b,ss.opacity);
        } else if (o.select_mode==SM_HIDE) image_fill_rect(&image,local,o.hide_r,o.hide_g,o.hide_b,o.hide_alpha);
        else if (o.select_mode==SM_BLUR) image_blur_rect(&image,local,o.blur_amount);
    }

    int thumb_w = 0, thumb_h = 0;
    if (o.thumb && strcmp(o.filename, "-")) {
        int64_t tw=o.thumb_w, th=o.thumb_h;
        if (o.thumb_percent) { tw=MAX2(INT64_C(1),(int64_t)image.w*o.thumb_percent/100); th=MAX2(INT64_C(1),(int64_t)image.h*o.thumb_percent/100); }
        else if (tw==0) tw=MAX2(INT64_C(1),(int64_t)llrint((double)th*image.w/image.h));
        else if (th==0) th=MAX2(INT64_C(1),(int64_t)llrint((double)tw*image.h/image.w));
        if (tw>INT_MAX||th>INT_MAX) die("thumbnail dimensions are too large");
        checked_image_bytes((int)tw,(int)th,3,"thumbnail");
        thumb_w=(int)tw; thumb_h=(int)th;
    }

    if (!title) title=window_title_for_target(&x,target_win);
    sanitize_component(title);
    Format prov=forced==FMT_AUTO?format_from_path(o.filename):forced;
    ExpandInfo ei={.title=title,.w=image.w,.h=image.h,.fmt=format_name(prov)};
    char *path=expand_filename(o.filename,&ei);
    sanitize_path_controls(path);
    Format fmt=forced==FMT_AUTO?format_from_path(path):forced;
    ei.fmt=format_name(fmt);

    if (strcmp(path,"-")) {
        const char *base=strrchr(path,'/'); base=base?base+1:path; const char *ext=strrchr(base,'.');
        if (forced==FMT_AUTO) {
            if (ext&&strcasecmp(ext,".png")&&strcasecmp(ext,".bmp")&&strcasecmp(ext,".dib")) warnx("unknown extension '%s'; writing %s data",ext,format_name(fmt));
        } else {
            bool ext_bmp=ext&&(!strcasecmp(ext,".bmp")||!strcasecmp(ext,".dib")); bool ext_png=ext&&!strcasecmp(ext,".png");
            if ((fmt==FMT_BMP&&ext_png)||(fmt==FMT_PNG&&ext_bmp)) warnx("--format %s does not match extension '%s'",format_name(fmt),ext);
        }
    }

    Buf encoded=fmt==FMT_BMP?encode_bmp(&image):encode_png(&image,o.compression);
    ei.bytes=encoded.n;
    if (!save_unique(&path,encoded.p,encoded.n,o.overwrite,0600)) { int e=errno; buf_free(&encoded); die("cannot save '%s': %s",path,strerror(e)); }
    buf_free(&encoded); ei.path=path;

    char *tpath=o.thumb?thumbnail_path(path):NULL; ei.thumb_path=tpath?tpath:"";
    if (o.thumb) {
        if (!strcmp(path,"-")) warnx("thumbnail skipped because main output is stdout");
        else {
            Image thumb=image_scale_bilinear(&image,thumb_w,thumb_h);
            Format tf=forced==FMT_AUTO?format_from_path(tpath):forced;
            Buf tb=tf==FMT_BMP?encode_bmp(&thumb):encode_png(&thumb,o.compression);
            if (!save_bytes_atomic(tpath,tb.p,tb.n,o.overwrite,0600)) warnx("cannot save thumbnail '%s': %s",tpath,strerror(errno));
            buf_free(&tb); image_free(&thumb);
        }
    }

    struct stat st; if (strcmp(path,"-")&&stat(path,&st)==0) ei.bytes=(size_t)st.st_size;
    int final_rc=0;
    if (o.exec_cmd&&strcmp(path,"-")) {
        int rc=run_post_command(o.exec_cmd,&ei);
        if (g_interrupted) final_rc=128+(g_signal?g_signal:SIGTERM);
        else if (rc!=0) warnx("post command exited with status %d",rc);
    }
    if (!final_rc && !o.silent&&strcmp(path,"-")) {
        fprintf(stderr,"Saved %s (%dx%d, %zu bytes)\n",path,image.w,image.h,ei.bytes);
        if (isatty(STDERR_FILENO)) fputc('\a',stderr);
    }

    free(tpath); free(path); free(title); image_free(&image); options_free(&o);
    XCloseDisplay(d); xext_close(&x.ext);
    close(g_sigpipe[0]); close(g_sigpipe[1]);
    return final_rc;
}
