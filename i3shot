    e->fixes=dlopen_any(fixes); e->randr=dlopen_any(randr); e->composite=dlopen_any(comp); e->xshape=dlopen_any(shape);
    if(e->fixes) *(void **)(&e->XFixesGetCursorImage)=dlsym(e->fixes,"XFixesGetCursorImage");
