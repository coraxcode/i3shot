    if (!title) title = window_title_for_target(&x, target_win);
    sanitize_component(title);                       /* $W cannot inject '/' or controls (H35) */

    Format prov = forced == FMT_AUTO ? format_from_path(o.filename) : forced;
    ExpandInfo ei = { .title = title, .w = image.w, .h = image.h, .fmt = format_name(prov) };
    char *path = expand_filename(o.filename, &ei);
    sanitize_path_controls(path);                    /* no newlines/controls in filenames (H36) */

    Format fmt = forced == FMT_AUTO ? format_from_path(path) : forced;   /* decide from final path (H34) */
    ei.fmt = format_name(fmt);
