static void options_free(Options*o){free(o->display);free(o->exec_cmd);free(o->class_name);free(o->line_style);free(o->select_opts);free(o->format_str);free(o->filename);}

static void countdown(const Options *o) {
    if (o->delay <= 0) return;
    if (!o->count) {
        sleep_seconds(o->delay);
        return;
    }
    int whole = (int)floor(o->delay);
    double rem = o->delay - whole;
    for (int i = whole; i > 0 && !g_interrupted; --i) {
        fprintf(stderr, "\rScreenshot in %d... ", i);
        fflush(stderr);
        sleep_seconds(1.0);
    }
    if (rem > 0 && !g_interrupted) sleep_seconds(rem);
    fprintf(stderr, "\r%*s\r", 32, "");
    fflush(stderr);
}

static Image join_monitors(XCtx*x,Rect*mons,int n,Rect*logical){
    int64_t w=0,h=0;
    for(int i=0;i<n;++i){w+=mons[i].w; if(mons[i].h>h)h=mons[i].h;}
    if(w<=0||h<=0||w>100000||h>100000)die("joined monitor area is too large");
    Image out=image_new((int)w,(int)h);int ox=0;
    for(int i=0;i<n;++i){Image p=capture_root(x,mons[i]);for(int y=0;y<p.h;++y)memcpy(out.rgb+((size_t)y*(size_t)w+(size_t)ox)*3,p.rgb+(size_t)y*p.w*3,(size_t)p.w*3);image_free(&p);ox+=mons[i].w;}
    *logical=(Rect){0,0,(int)w,(int)h};return out;
}

static char *window_title_for_target(XCtx*x,Window w){if(w==None||w==x->root)return xstrdup("");return get_text_property_utf8(x->dpy,w,"_NET_WM_NAME");}

int main(int argc,char**argv){install_signals();XSetErrorHandler(xerror_handler);Options o=parse_options(argc,argv);Format forced=parse_format(o.format_str);Display*d=XOpenDisplay(o.display);if(!d)die("cannot open X display '%s'",o.display?o.display:(getenv("DISPLAY")?getenv("DISPLAY"):"(unset)"));XCtx x={0};x.dpy=d;x.screen=DefaultScreen(d);x.root=RootWindow(d,x.screen);x.root_w=DisplayWidth(d,x.screen);x.root_h=DisplayHeight(d,x.screen);xext_load(&x.ext);
    SelectStyle ss;parse_line_style(&x,o.line_style,&ss);Rect cap={0,0,x.root_w,x.root_h};Window target_win=None;char*title=NULL;Image image={0};bool image_ready=false;XImage*frozen=NULL;
    /* Delay ordering: with the 'b' prefix the delay runs before selection. For
       every non-selection target the normal delay must elapse BEFORE we resolve
       and capture, so focus/workspace/window changes are honored (C13). */
    if(o.delay_before_select)countdown(&o);
    else if(o.target!=T_SELECT)countdown(&o);
    if(g_interrupted){options_free(&o);XCloseDisplay(d);xext_close(&x.ext);return 130;}
    switch(o.target){
    case T_FULL:break;
    case T_AREA:cap=o.area;break;
    case T_FOCUSED:
        target_win = get_active_window(&x);
        if (target_win == None || target_win == PointerRoot) die("no focused X11 window");
        if (o.composite && !o.border) {
            image = capture_window_content(&x, target_win, true);
            image_ready = true;
            cap = (Rect){0, 0, image.w, image.h};
        } else if (!(o.border && i3_window_rect(&x, target_win, &cap)) &&
                   !window_absolute_rect(&x, target_win, o.border, &cap)) {
            die("cannot determine focused window geometry");
        }
        break;
    case T_WINDOW:
        target_win = o.window;
        if (o.composite && !o.border) {
            image = capture_window_content(&x, target_win, true);
            image_ready = true;
            cap = (Rect){0, 0, image.w, image.h};
        } else if (!(o.border && i3_window_rect(&x, target_win, &cap)) &&
                   !window_absolute_rect(&x, target_win, o.border, &cap)) {
            die("cannot determine window geometry");
        }
        break;
    case T_MONITOR:{if(!x.ext.XRRGetMonitors)warnx("XRandR unavailable; monitor geometry may be the whole screen");int n=0;Rect*m=get_monitors(&x,&n);if(o.monitor<0||o.monitor>=n){free(m);die("monitor %d does not exist; available range is 0..%d",o.monitor,n-1);}cap=m[o.monitor];free(m);break;}
    case T_MULTI:{int n=0;Rect*m=get_monitors(&x,&n);image=join_monitors(&x,m,n,&cap);image_ready=true;free(m);break;}
    case T_STACK:image=capture_stack_under_pointer(&x,o.stack_vertical,o.class_name,true,&cap);image_ready=true;break;
    case T_I3_CONTAINER:if(!i3_tree_target(&x,"container",&cap,&target_win,&title))die("cannot obtain focused container from i3 IPC");break;
    case T_I3_WORKSPACE:if(!i3_tree_target(&x,"workspace",&cap,NULL,&title))die("cannot obtain focused workspace from i3 IPC");break;
    case T_I3_OUTPUT:if(!i3_current_output(&x,&cap))die("cannot obtain current output from i3 IPC");break;
    case T_SELECT:{Window clicked=None;if(!interactive_select(&x,o.freeze,o.ignore_keyboard,&ss,&cap,&clicked,&frozen)){options_free(&o);XCloseDisplay(d);xext_close(&x.ext);return 1;}target_win=clicked;if(clicked!=None&&o.border){if(!i3_window_rect(&x,clicked,&cap))window_absolute_rect(&x,clicked,true,&cap);}break;}
    }
    if (!o.delay_before_select && o.target == T_SELECT) countdown(&o);  /* preserve chosen rect */
    if (g_interrupted) {
        if (frozen) XDestroyImage(frozen);
        options_free(&o);
        XCloseDisplay(d);
        xext_close(&x.ext);
        return 130;
    }

    Rect root_bounds = {0, 0, x.root_w, x.root_h};
    Rect selected_rect = cap;
    Rect cursor_rect = cap;
    bool cursor_has_root_mapping = false;

    if (o.target == T_SELECT && o.select_mode != SM_CAPTURE) {
        selected_rect = rect_intersect(selected_rect, root_bounds);
        if (!rect_valid(selected_rect)) die("selected rectangle is empty after clipping");
        if (frozen) {
            image = ximage_to_rgb(frozen, root_bounds);
            XDestroyImage(frozen);
            frozen = NULL;
        } else {
            image = capture_root(&x, root_bounds);
        }
        image_ready = true;
        cap = root_bounds;
        cursor_rect = root_bounds;
        cursor_has_root_mapping = true;
    } else if (!image_ready) {
        cap = rect_intersect(cap, root_bounds);
        if (!rect_valid(cap)) die("capture rectangle is empty after clipping");
        if (frozen) {
            image = ximage_to_rgb(frozen, cap);
            XDestroyImage(frozen);
            frozen = NULL;
        } else {
            image = capture_root(&x, cap);
        }
        image_ready = true;
        cursor_rect = cap;
        cursor_has_root_mapping = true;
    } else if (o.composite && (o.target == T_WINDOW || o.target == T_FOCUSED)) {
        Rect wr;
        if (window_absolute_rect(&x, target_win, false, &wr)) {
            cursor_rect = wr;
            cursor_has_root_mapping = (wr.w == image.w && wr.h == image.h);
        }
    }

    if (o.pointer) {
        if (cursor_has_root_mapping) compose_cursor(&x, &image, cursor_rect);
