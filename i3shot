    if(o.thumb){if(!strcmp(path,"-"))warnx("thumbnail skipped because main output is stdout");else{int tw=o.thumb_w,th=o.thumb_h;if(o.thumb_percent){tw=MAX2(1,image.w*o.thumb_percent/100);th=MAX2(1,image.h*o.thumb_percent/100);}else if(tw==0)tw=MAX2(1,(int)lrint((double)th*image.w/image.h));else if(th==0)th=MAX2(1,(int)lrint((double)tw*image.h/image.w));Image thumb=image_scale_bilinear(&image,tw,th);Format tf=forced==FMT_AUTO?format_from_path(tpath):forced;Buf tb=tf==FMT_BMP?encode_bmp(&thumb):encode_png(&thumb,o.compression);if(!save_bytes_atomic(tpath,tb.p,tb.n,o.overwrite,0644)){int e=errno;buf_free(&tb);image_free(&thumb);die("cannot save thumbnail '%s': %s",tpath,strerror(e));}buf_free(&tb);image_free(&thumb);}}
