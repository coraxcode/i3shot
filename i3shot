        v[i]=x; e=ne;
    }
    if(*e) die("invalid rectangle '%s'; expected X,Y,W,H",s);
    if(v[2]<=0||v[3]<=0) die("rectangle width and height must be positive");
    if(v[0]<INT_MIN||v[0]>INT_MAX||v[1]<INT_MIN||v[1]>INT_MAX||v[2]>INT_MAX||v[3]>INT_MAX) die("rectangle values out of range");
    Rect r={(int)v[0],(int)v[1],(int)v[2],(int)v[3]}; return r;
}
static void parse_thumb(Options*o,const char*s){
    o->thumb=true;
    const char*xp=strpbrk(s,"xX");
    if(xp){
        char stem[64]; size_t n=(size_t)(xp-s);
        if(n>=sizeof stem) die("invalid thumbnail '%s'",s);
        memcpy(stem,s,n); stem[n]=0;
        int w=0,h=0;
        if(!parse_int_strict(stem,0,100000,&w)||!parse_int_strict(xp+1,0,100000,&h)||(w==0&&h==0))
            die("invalid thumbnail '%s'; expected WxH",s);
        o->thumb_w=w; o->thumb_h=h;
    }else{
        int p; if(!parse_int_strict(s,1,1000,&p)) die("invalid thumbnail percentage '%s'",s);
        o->thumb_percent=p;
    }
}
static void parse_select_opts(Options*o,const char*s){
    o->select_mode=SM_CAPTURE; o->blur_amount=18; o->hide_r=o->hide_g=o->hide_b=0; o->hide_alpha=255;
    if(!s||!*s||!strcmp(s,"capture")) return;
    char*c=xstrdup(s); char*comma=strchr(c,','); if(comma)*comma++=0;
    if(!strcmp(c,"hole")) o->select_mode=SM_HOLE;
