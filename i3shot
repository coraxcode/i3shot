static bool i3_request_path(const char *path,uint32_t type,const char*payload,int64_t deadline,I3Reply*out){
    int fd=sock_connect(path,deadline);if(fd<0){g_i3_error=I3E_CONNECT;return false;}
    size_t plen=payload?strlen(payload):0;if(plen>UINT32_MAX){close(fd);g_i3_error=I3E_SIZE;return false;}uint32_t len=(uint32_t)plen;
    uint8_t hdr[14];memcpy(hdr,"i3-ipc",6);memcpy(hdr+6,&len,4);memcpy(hdr+10,&type,4);
    if(!sock_write_all(fd,hdr,sizeof hdr,deadline)|| (len&&!sock_write_all(fd,payload,len,deadline))){close(fd);if(g_i3_error==I3E_NONE)g_i3_error=I3E_READ;return false;}
    uint8_t rh[14];if(!sock_read_all(fd,rh,sizeof rh,deadline)){close(fd);if(g_i3_error==I3E_NONE)g_i3_error=I3E_READ;return false;}
    if(memcmp(rh,"i3-ipc",6)){close(fd);g_i3_error=I3E_PROTOCOL;return false;}
    uint32_t rlen,rtype;memcpy(&rlen,rh+6,4);memcpy(&rtype,rh+10,4);
    if(rtype!=type){close(fd);g_i3_error=I3E_TYPE;return false;}
