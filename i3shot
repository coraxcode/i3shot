/* Monotonic milliseconds for IPC deadlines. */
static long now_ms(void) {
    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
    return ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
}

/* Wait for readiness on one fd, bounded and signal-aware. */
static bool fd_wait(int fd, short events, long deadline) {
    for (;;) {
        long rem = deadline - now_ms();
        if (rem <= 0 || g_interrupted) return false;
        struct pollfd p = { fd, events, 0 };
        int r = poll(&p, 1, (int)MIN2(rem, 1000L));
        if (r > 0) return (p.revents & (events | POLLERR | POLLHUP)) != 0;
        if (r == 0) continue;
        if (errno == EINTR) { if (g_interrupted) return false; continue; }
        return false;
    }
}

static bool sock_write_all(int fd, const void *buf, size_t len, long deadline) {
    const uint8_t *p = buf;
    while (len) {
        if (!fd_wait(fd, POLLOUT, deadline)) return false;
        ssize_t n = write(fd, p, len);
        if (n < 0) { if (errno==EINTR||errno==EAGAIN||errno==EWOULDBLOCK) { if(g_interrupted) return false; continue; } return false; }
        if (n == 0) return false;
        p += (size_t)n; len -= (size_t)n;
    }
    return true;
}

static bool sock_read_all(int fd, void *buf, size_t len, long deadline) {
    uint8_t *p = buf;
    while (len) {
        if (!fd_wait(fd, POLLIN, deadline)) return false;
        ssize_t n = read(fd, p, len);
        if (n < 0) { if (errno==EINTR||errno==EAGAIN||errno==EWOULDBLOCK) { if(g_interrupted) return false; continue; } return false; }
        if (n == 0) return false;
        p += (size_t)n; len -= (size_t)n;
    }
    return true;
}

/* Nonblocking connect with a deadline so a dead socket cannot hang us. */
static int sock_connect(const char *path, long deadline) {
    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
    if (fd < 0) return -1;
    struct sockaddr_un sa; memset(&sa, 0, sizeof(sa)); sa.sun_family = AF_UNIX;
    if (strlen(path) >= sizeof(sa.sun_path)) { close(fd); return -1; }
    strcpy(sa.sun_path, path);
    if (connect(fd, (struct sockaddr*)&sa, sizeof(sa)) == 0) return fd;
    if (errno != EINPROGRESS) { close(fd); return -1; }
    if (!fd_wait(fd, POLLOUT, deadline)) { close(fd); return -1; }
    int err = 0; socklen_t el = sizeof(err);
    if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &el) < 0 || err) { close(fd); return -1; }
    return fd;
}

/* Send one i3 IPC request and return the reply body (NUL-terminated), or NULL.
   Enforces a strict deadline and requires the reply type to match the request. */
static char *i3_request(XCtx *x, uint32_t type, const char *payload) {
    const char *env = getenv("I3SOCK");
    char *owned = NULL;
    const char *path = (env && *env) ? env : (owned = x11_i3_socket(x));
    if (!path || !*path) { free(owned); return NULL; }
    long deadline = now_ms() + 3000;               /* 3s total budget */
    int fd = sock_connect(path, deadline);
    free(owned);
    if (fd < 0) return NULL;

    uint32_t len = (uint32_t)(payload ? strlen(payload) : 0);
    uint8_t hdr[14]; memcpy(hdr, "i3-ipc", 6); memcpy(hdr + 6, &len, 4); memcpy(hdr + 10, &type, 4);
    char *out = NULL;
    if (sock_write_all(fd, hdr, sizeof(hdr), deadline) && (!len || sock_write_all(fd, payload, len, deadline))) {
        uint8_t rh[14];
        if (sock_read_all(fd, rh, sizeof(rh), deadline) && !memcmp(rh, "i3-ipc", 6)) {
            uint32_t rlen, rtype; memcpy(&rlen, rh + 6, 4); memcpy(&rtype, rh + 10, 4);
            if (rtype == type && rlen <= 16u * 1024u * 1024u) {   /* reply type must match request */
                out = xmalloc((size_t)rlen + 1);
                if (sock_read_all(fd, out, rlen, deadline)) out[rlen] = 0;
                else { free(out); out = NULL; }
            }
        }
    }
    close(fd);
    return out;
}

static int nearest_object_type(const char *js, const JTok *t, int nt, int idx, const char *type) {
    for (int p = idx; p >= 0; p = t[p].parent) {
        if (p < nt && t[p].type == JT_OBJECT) {
            int ty = object_get(js, t, nt, p, "type");
            if (ty >= 0 && tok_eq(js, &t[ty], type)) return p;
        }
    }
    return -1;
}

static bool i3_tree_target(XCtx *x, const char *kind, Rect *r, Window *wid, char **title) {
    char *js = i3_request(x, 4, "");
    if (!js) return false;
    JTok *t = NULL;
    int nt = json_parse(js, strlen(js), &t);
    if (nt < 1) { free(js); return false; }

    int focused = find_object_field(js, t, nt, 0, "focused", "true", JT_PRIMITIVE);
    int obj = focused;
    if (!strcmp(kind, "workspace") && focused >= 0)
        obj = nearest_object_type(js, t, nt, focused, "workspace");

    bool ok = obj >= 0 && object_rect(js, t, nt, obj, "rect", r);
    if (ok && wid) {
        int w = object_get(js, t, nt, obj, "window");
        *wid = (w >= 0 && !tok_prim_eq(js, &t[w], "null")) ? (Window)tok_long(js, &t[w], 0) : None;
    }
    if (ok && title) {
        int n = object_get(js, t, nt, obj, "name");
        *title = n >= 0 ? tok_string(js, &t[n]) : xstrdup("");
    }
    free(t);
    free(js);
    return ok;
}

static bool i3_window_rect(XCtx *x, Window window, Rect *r) {
    char *js = i3_request(x, 4, "");
    if (!js) return false;
    JTok *t = NULL;
    int nt = json_parse(js, strlen(js), &t);
    bool ok = false;
    if (nt > 0) {
        for (int i = 0; i < nt; ++i) {
            if (t[i].type != JT_OBJECT) continue;
            int w = object_get(js, t, nt, i, "window");
            if (w >= 0 && !tok_prim_eq(js, &t[w], "null") &&
                (Window)tok_long(js, &t[w], 0) == window && object_rect(js, t, nt, i, "rect", r)) {
                ok = true;
                break;
            }
        }
    }
    free(t);
    free(js);
    return ok;
}

