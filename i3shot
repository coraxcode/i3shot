/* Replace path separators and control bytes so a filename component (e.g. a
   window title in $W) cannot escape the output directory or inject control
   characters into logs/terminals. */
static void sanitize_component(char *s){ if(!s)return; for(;*s;++s){unsigned char c=(unsigned char)*s; if(c=='/'||c<0x20||c==0x7f)*s='_';} }
/* Keep '/' (directories) but strip control bytes from a full path. */
static void sanitize_path_controls(char *s){ if(!s)return; for(;*s;++s){unsigned char c=(unsigned char)*s; if(c<0x20||c==0x7f)*s='_';} }

static char *str_replace_vars(const char *in, const ExpandInfo *i) {
    Buf b = {0};
    char num[64];
    for (size_t p = 0; in[p]; ++p) {
        if (in[p] == '$') {
            char c = in[p+1];
            const char *v = NULL;
            switch (c) {
            case '$': buf_u8(&b, '$'); ++p; continue;
            case 'f': v = i->path; break;
            case 'm': v = i->thumb_path; break;
            case 'n': { const char *q = i->path ? strrchr(i->path, '/') : NULL; v = q ? q+1 : i->path; } break;
            case 'w': snprintf(num,sizeof(num),"%d",i->w); v=num; break;
            case 'h': snprintf(num,sizeof(num),"%d",i->h); v=num; break;
            case 'p': snprintf(num,sizeof(num),"%lld",(long long)i->w*(long long)i->h); v=num; break;
            case 's': snprintf(num,sizeof(num),"%zu",i->bytes); v=num; break;
            case 'F': case 't': v=i->fmt; break;
            case 'W': v=i->title; break;
            case 'a': {
                static char host[256];
                if (gethostname(host,sizeof(host)) < 0) strcpy(host,"unknown");
                host[sizeof(host)-1] = 0; v=host;
            } break;
            default: buf_u8(&b,'$'); continue;
            }
            if (v) { buf_put(&b,v,strlen(v)); ++p; continue; }
        }
        if (in[p] == '\\' && in[p+1] == 'n') { buf_u8(&b,'\n'); ++p; }
        else buf_u8(&b,(uint8_t)in[p]);
    }
    buf_u8(&b,0);
    return (char*)b.p;
}

static char *expand_filename(const char *pattern,const ExpandInfo*i){char timebuf[PATH_MAX*2];time_t now=time(NULL);struct tm tm;localtime_r(&now,&tm);size_t k=strftime(timebuf,sizeof(timebuf),pattern,&tm);if(k==0&&pattern[0])die("cannot expand filename pattern (too long or unsupported time format)");if(k==0)timebuf[0]=0;return str_replace_vars(timebuf,i);}

