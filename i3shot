static Rect parse_rect_arg(const char*s){Rect r;char tail;if(sscanf(s,"%d,%d,%d,%d%c",&r.x,&r.y,&r.w,&r.h,&tail)!=4||r.w<=0||r.h<=0)die("invalid rectangle '%s'; expected X,Y,W,H",s);return r;}
static void parse_thumb(Options*o,const char*s){o->thumb=true;if(strchr(s,'x')||strchr(s,'X')){char tail;if(sscanf(s,"%dx%d%c",&o->thumb_w,&o->thumb_h,&tail)!=2||o->thumb_w<0||o->thumb_h<0||(o->thumb_w==0&&o->thumb_h==0))die("invalid thumbnail '%s'",s);}else{o->thumb_percent=atoi(s);if(o->thumb_percent<=0||o->thumb_percent>1000)die("invalid thumbnail percentage '%s'",s);}}
static void parse_select_opts(Options*o,const char*s){o->select_mode=SM_CAPTURE;o->blur_amount=18;o->hide_r=o->hide_g=o->hide_b=0;o->hide_alpha=255;if(!s||!*s||!strcmp(s,"capture"))return;char*c=xstrdup(s);char*comma=strchr(c,',');if(comma)*comma++=0;if(!strcmp(c,"hole"))o->select_mode=SM_HOLE;else if(!strcmp(c,"hide")){o->select_mode=SM_HIDE;if(comma&&!parse_hex_color(comma,&o->hide_r,&o->hide_g,&o->hide_b))die("hide cover must be a #RRGGBB color in this no-decoder build");}else if(!strcmp(c,"blur")){o->select_mode=SM_BLUR;if(comma)o->blur_amount=CLAMP(atoi(comma),1,30);}else die("unknown selection mode '%s'",c);free(c);}

static Options parse_options(int argc,char**argv){Options o={0};o.target=T_FULL;o.quality=75;o.compression=7;o.monitor=-1;o.select_mode=SM_CAPTURE;o.blur_amount=18;o.hide_alpha=255;enum{OPT_FORMAT=1000,OPT_LIST,OPT_CONTAINER,OPT_WORKSPACE,OPT_OUTPUT,OPT_FULL,OPT_COMPOSITE};static const struct option lo[]={
{"autoselect",required_argument,0,'a'},{"border",no_argument,0,'b'},{"class",required_argument,0,'C'},{"count",no_argument,0,'c'},{"display",required_argument,0,'D'},{"delay",required_argument,0,'d'},{"exec",required_argument,0,'e'},{"file",required_argument,0,'F'},{"freeze",no_argument,0,'f'},{"help",no_argument,0,'h'},{"ignorekeyboard",no_argument,0,'i'},{"stack",optional_argument,0,'k'},{"line",required_argument,0,'l'},{"monitor",required_argument,0,'M'},{"multidisp",no_argument,0,'m'},{"overwrite",no_argument,0,'o'},{"pointer",no_argument,0,'p'},{"quality",required_argument,0,'q'},{"select",optional_argument,0,'s'},{"thumb",required_argument,0,'t'},{"focused",no_argument,0,'u'},{"focussed",no_argument,0,'u'},{"version",no_argument,0,'v'},{"window",required_argument,0,'w'},{"compression",required_argument,0,'Z'},{"silent",no_argument,0,'z'},{"format",required_argument,0,OPT_FORMAT},{"list-options",optional_argument,0,OPT_LIST},{"container",no_argument,0,OPT_CONTAINER},{"workspace",no_argument,0,OPT_WORKSPACE},{"output",required_argument,0,OPT_OUTPUT},{"full",no_argument,0,OPT_FULL},{"composite",no_argument,0,OPT_COMPOSITE},{0,0,0,0}};
    int ch;opterr=0;while((ch=getopt_long(argc,argv,"a:bC:cd:e:F:fhik::l:M:mopq:s::t:uvw:Z:z",lo,NULL))!=-1){switch(ch){case'a':o.target=T_AREA;o.area=parse_rect_arg(optarg);break;case'b':o.border=true;break;case'C':o.class_name=xstrdup(optarg);break;case'c':o.count=true;break;case'D':o.display=xstrdup(optarg);break;case'd':{const char*s=optarg;if(*s=='b'){o.delay_before_select=true;s++;}char*e;o.delay=strtod(s,&e);if(*e||o.delay<0)die("invalid delay '%s'",optarg);}break;case'e':o.exec_cmd=xstrdup(optarg);break;case'F':free(o.filename);o.filename=xstrdup(optarg);break;case'f':o.freeze=true;break;case'h':usage(stdout);exit(0);case'i':o.ignore_keyboard=true;break;case'k':o.target=T_STACK;o.stack_vertical=optarg&&*optarg=='v';break;case'l':o.line_style=xstrdup(optarg);break;case'M':o.target=T_MONITOR;o.monitor=atoi(optarg);break;case'm':o.target=T_MULTI;o.multidisp=true;break;case'o':o.overwrite=true;break;case'p':o.pointer=true;break;case'q':o.quality=atoi(optarg);if(o.quality<1||o.quality>100)die("quality must be 1..100");break;case's':o.target=T_SELECT;o.select_opts=xstrdup(optarg?optarg:"capture");parse_select_opts(&o,optarg);break;case't':parse_thumb(&o,optarg);break;case'u':o.target=T_FOCUSED;break;case'v':printf("i3shot %s\n",I3SHOT_VERSION);exit(0);case'w':{char*e;errno=0;unsigned long v=strtoul(optarg,&e,0);if(errno||*e||!v)die("invalid window ID '%s'",optarg);o.target=T_WINDOW;o.window=(Window)v;}break;case'Z':o.compression=atoi(optarg);if(o.compression<0||o.compression>9)die("compression must be 0..9");break;case'z':o.silent=true;break;case OPT_FORMAT:o.format_str=xstrdup(optarg);break;case OPT_LIST:usage(stdout);exit(0);case OPT_CONTAINER:o.target=T_I3_CONTAINER;break;case OPT_WORKSPACE:o.target=T_I3_WORKSPACE;break;case OPT_OUTPUT:if(strcmp(optarg,"current"))die("only --output current is supported");o.target=T_I3_OUTPUT;break;case OPT_FULL:o.target=T_FULL;break;case OPT_COMPOSITE:o.composite=true;break;case'?':default:die("unknown or malformed option; use --help");}}
    if(optind<argc){if(o.filename)die("output file specified more than once");o.filename=xstrdup(argv[optind++]);}if(optind<argc)die("too many arguments");if(!o.filename)o.filename=xstrdup("%Y-%m-%d_%H-%M-%S_$wx$h.png");return o;}

static void options_free(Options*o){free(o->display);free(o->exec_cmd);free(o->class_name);free(o->line_style);free(o->select_opts);free(o->format_str);free(o->filename);}

static void countdown(const Options *o) {
    if (o->delay <= 0) return;
    if (!o->count) {
        sleep_seconds(o->delay);
        return;
    }
    int whole = (int)floor(o->delay);
    double rem = o->delay - whole;
    for (int i = whole; i > 0 && !g_interrupted; --i) {
        fprintf(stderr, "\rScreenshot in %d... ", i);
        fflush(stderr);
        sleep_seconds(1.0);
    }
    if (rem > 0 && !g_interrupted) sleep_seconds(rem);
    fprintf(stderr, "\r%*s\r", 32, "");
    fflush(stderr);
}

static Image join_monitors(XCtx*x,Rect*mons,int n,Rect*logical){int w=0,h=0;for(int i=0;i<n;++i){w+=mons[i].w;h=MAX2(h,mons[i].h);}Image out=image_new(w,h);int ox=0;for(int i=0;i<n;++i){Image p=capture_root(x,mons[i]);for(int y=0;y<p.h;++y)memcpy(out.rgb+((size_t)y*w+ox)*3,p.rgb+(size_t)y*p.w*3,(size_t)p.w*3);image_free(&p);ox+=mons[i].w;}*logical=(Rect){0,0,w,h};return out;}

static char *window_title_for_target(XCtx*x,Window w){if(w==None||w==x->root)return xstrdup("");return get_text_property_utf8(x->dpy,w,"_NET_WM_NAME");}

int main(int argc,char**argv){signal(SIGINT,on_signal);signal(SIGTERM,on_signal);signal(SIGPIPE,SIG_IGN);XSetErrorHandler(xerror_handler);Options o=parse_options(argc,argv);Format forced=parse_format(o.format_str);Display*d=XOpenDisplay(o.display);if(!d)die("cannot open X display '%s'",o.display?o.display:(getenv("DISPLAY")?getenv("DISPLAY"):"(unset)"));XCtx x={0};x.dpy=d;x.screen=DefaultScreen(d);x.root=RootWindow(d,x.screen);x.root_w=DisplayWidth(d,x.screen);x.root_h=DisplayHeight(d,x.screen);xext_load(&x.ext);
